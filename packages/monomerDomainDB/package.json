{
  "name": "@datagrok/monomerdomaindb",
  "friendlyName": "monomerDomainDB",
  "version": "0.0.1",
  "description": "Monomer library provider backed by Datagrok domain schemas (entity-mapped tables): server-enforced security, per-row CRUD, audit, dedup/upsert",
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "dependencies": {
    "@datagrok-libraries/bio": "^6.0.3",
    "@datagrok-libraries/test": "^1.1.0",
    "cash-dom": "^8.1.5",
    "datagrok-api": "../../js-api",
    "dayjs": "^1.11.13",
    "rxjs": "^6.5.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "datagrok-tools": "^5.1.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "link-all": "grok link",
    "lint": "eslint \"src/**/*.ts\"",
    "lint-fix": "eslint \"src/**/*.ts\" --fix",
    "build": "grok api && grok check --soft && webpack",
    "test": "grok test",
    "debug-monomerdomaindb": "webpack && grok publish",
    "release-monomerdomaindb": "webpack && grok publish --release",
    "debug-monomerdomaindb-localhost": "webpack && grok publish localhost",
    "release-monomerdomaindb-localhost": "webpack && grok publish localhost --release"
  },
  "canEdit": [
    "Developers"
  ],
  "canView": [
    "All users"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/monomerDomainDB"
  },
  "overrides": {
    "datagrok-api": "$datagrok-api"
  }
}
