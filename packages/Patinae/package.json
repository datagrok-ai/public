{
  "name": "@datagrok/patinae",
  "friendlyName": "Patinae",
  "version": "0.0.1",
  "description": "Patinae molecular viewer (WebAssembly + WebGPU): previews for PyMOL .pse, .prs and .pml files",
  "author": {
    "name": "Alex Skalkin",
    "email": "askalkin@datagrok.ai"
  },
  "dependencies": {
    "datagrok-api": "^1.26.0",
    "@datagrok-libraries/test": "^1.1.0"
  },
  "devDependencies": {
    "datagrok-tools": "^5.1.5",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "latest",
    "typescript": "latest",
    "css-loader": "^6.4.0",
    "style-loader": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0"
  },
  "scripts": {
    "debug-patinae": "webpack && grok publish",
    "release-patinae": "webpack && grok publish --release",
    "build-patinae": "webpack",
    "build": "grok api && grok check --soft && webpack",
    "build:wasm": "bash wasm-src/build.sh",
    "test": "grok test",
    "lint": "eslint src --ext .ts",
    "lint-fix": "eslint src --ext .ts --fix",
    "debug-patinae-dev": "webpack && grok publish dev",
    "release-patinae-dev": "webpack && grok publish dev --release",
    "debug-patinae-public": "webpack && grok publish public",
    "release-patinae-public": "webpack && grok publish public --release",
    "debug-patinae-localhost": "webpack && grok publish localhost",
    "release-patinae-localhost": "webpack && grok publish localhost --release"
  },
  "canEdit": [
    "Developers"
  ],
  "canView": [
    "All users"
  ],
  "category": "Bioinformatics",
  "meta": {
    "browserFeatures": [
      "wasm"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Patinae"
  }
}
