{
  "name": "@datagrok/power-pack",
  "friendlyName": "Power Pack",
  "sources": [
    "css/power-pack.css"
  ],
  "version": "1.8.3",
  "author": {
    "name": "Andrew Skalkin",
    "email": "askalkin@datagrok.ai"
  },
  "description": "Commonly used platform enhancements",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/PowerPack"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.16.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.3",
    "@datagrok-libraries/db-explorer": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/u2": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "codemirror": "^6.0.1",
    "core-js": "^3.37.0",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "exceljs": "catalog:",
    "fuse.js": "^6.6.2",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "path": "^0.12.7",
    "yaml": "^2.3.4"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "properties": [
    {
      "name": "searchTemplatePaths",
      "propertyType": "string",
      "defaultValue": "Admin:Home/templates;System:AppData/PowerPack/search-templates",
      "nullable": false
    },
    {
      "name": "allowEditDFLines",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    }
  ],
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "General",
  "meta": {
    "semanticTypes": [
      {
        "semType": "DG_USER_LOGIN",
        "description": "Datagrok User Login",
        "parsers": [
          {
            "regexp": "DGUSER-[^\\s]+"
          }
        ]
      }
    ]
  },
  "playwrightTests": "playwright"
}
