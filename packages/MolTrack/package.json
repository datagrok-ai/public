{
  "name": "@datagrok/moltrack",
  "friendlyName": "Mol Track",
  "version": "0.0.2",
  "description": "Enables registering, tracking, and searching chemical compounds and batches.",
  "author": {
    "name": "Oleksandra Serhiienko",
    "email": "oserhiienko@datagrok.ai"
  },
  "dependencies": {
    "@datagrok-libraries/ems": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/u2": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:"
  },
  "devDependencies": {
    "@datagrok-libraries/bdd": "workspace:^",
    "@playwright/test": "^1.62.1"
  },
  "properties": [
    {
      "name": "CompoundMatchingRule",
      "friendlyName": "Compound matching rule",
      "description": "Which registration-hash layers decide that two structures are the same compound in MolTrack; a change applies to registrations made after it",
      "propertyType": "string",
      "choices": [
        "ALL_LAYERS",
        "STEREO_INSENSITIVE_LAYERS",
        "TAUTOMER_INSENSITIVE_LAYERS"
      ],
      "defaultValue": "ALL_LAYERS",
      "nullable": false
    },
    {
      "name": "SimilarityThreshold",
      "friendlyName": "Similarity threshold",
      "description": "The lowest Tanimoto similarity an \"is similar to\" structure condition accepts in MolTrack",
      "propertyType": "double",
      "defaultValue": 0.5,
      "nullable": false
    }
  ],
  "scripts": {
    "build": "grok api && grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/MolTrack"
  },
  "category": "Cheminformatics",
  "meta": {
    "browserFeatures": [
      "wasm"
    ]
  }
}
