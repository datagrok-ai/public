{
  "name": "@datagrok/bionemo",
  "friendlyName": "BioNeMo",
  "fullName": "BioNeMo",
  "version": "1.3.2",
  "author": {
    "name": "Oleksandra Serhiienko",
    "email": "oserhiienko@datagrok.ai"
  },
  "description": "Advanced models for protein structure prediction and molecular docking",
  "dependencies": {
    "@datagrok-libraries/bio": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "axios": "^1.7.4",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "@datagrok-libraries/chem-meta": "workspace:^"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/BioNeMo"
  },
  "properties": [
    {
      "name": "apiKey",
      "propertyType": "string",
      "defaultValue": "",
      "description": "Enter NGC api key",
      "nullable": false
    }
  ],
  "category": "Bioinformatics",
  "grok": {
    "testDependencies": [
      "@datagrok/biostructure-viewer"
    ]
  }
}
