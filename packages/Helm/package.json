{
  "name": "@datagrok/helm",
  "friendlyName": "Helm",
  "version": "3.0.6",
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "description": "Provides support for HELM notation (importing, detecting, rendering, conversion).",
  "properties": [
    {
      "name": "MonomersPerRow",
      "description": "Number of monomers per row before a HELM structure wraps to the next line. Counts nucleotides for RNA/DNA.",
      "propertyType": "int",
      "defaultValue": "20",
      "nullable": false
    }
  ],
  "sources": [
    "css/helm.css"
  ],
  "dependencies": {
    "@datagrok-libraries/bio": "workspace:^",
    "@datagrok-libraries/chem-meta": "workspace:^",
    "@datagrok-libraries/hwe": "^1.1.1",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@datagrok-libraries/bdd": "workspace:^",
    "@datagrok-libraries/ml": "workspace:^",
    "@playwright/test": "^1.48.0"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test",
    "test:bdd": "grok-bdd run"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Helm"
  },
  "category": "Bioinformatics",
  "playwrightTests": "playwright",
  "grok": {
    "testDependencies": [
      "@datagrok/bio",
      "@datagrok/chem"
    ]
  }
}
