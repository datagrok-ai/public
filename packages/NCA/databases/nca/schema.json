{
  "$schema": "https://datagrok.ai/schemas/domain-schema.schema.json",
  "name": "nca",
  "version": "0.2.0",
  "tables": {
    "study": {
      "securityMode": "row",
      "promotion": "eager",
      "defaultRowVisibility": "none",
      "friendlyName": "NCA studies",
      "description": "A study groups NCA analyses; kind=standalone is the one-analysis container of an analysis not in a study (Ungrouped). Sharing is granted on this row",
      "grants": {"All users": ["view", "edit"]},
      "businessKey": ["pipeline_owner", "pipeline_study_key"],
      "columns": {
        "label": {"type": "string", "required": true, "isName": true, "searchable": true, "friendlyName": "Name", "description": "Unique among the caller's visible studies (app rule, not a DB constraint)"},
        "kind": {"type": "string", "required": true, "choices": ["study", "standalone"], "default": "study", "friendlyName": "Kind"},
        "pipeline_owner": {"type": "string", "friendlyName": "Pipeline owner", "description": "Owner login or group of a pipeline-saved study; null for an app study"},
        "pipeline_study_key": {"type": "string", "friendlyName": "Pipeline study key"},
        "updated_at": {"type": "datetime", "friendlyName": "Updated", "description": "Last content change of the study or one of its analyses (not a background results refresh)"},
        "moved_to": {"type": "string", "friendlyName": "Moved to", "description": "Study id a standalone container's analysis was moved into"}
      }
    },
    "pipeline_run": {
      "securityMode": "master",
      "delegate": "study_id",
      "friendlyName": "NCA pipeline runs",
      "description": "One pipeline run in one study: what the run received, stated once for every analysis it wrote there",
      "businessKey": ["run_id", "study_id"],
      "columns": {
        "study_id": {"type": "ref", "ref": "study", "required": true, "onDelete": "cascade", "friendlyName": "Study"},
        "run_id": {"type": "string", "required": true, "friendlyName": "Run id", "description": "The same for every study one run wrote into"},
        "run_at": {"type": "datetime", "friendlyName": "Run at"},
        "run_user": {"type": "string", "friendlyName": "Run by", "description": "The runner's login"},
        "engine_version": {"type": "string", "friendlyName": "Engine version", "description": "sci-comp version the run computed with"},
        "rules": {"type": "string", "friendlyName": "Rules", "description": "The rules JSON the run received, verbatim"},
        "mapping": {"type": "string", "friendlyName": "Mapping", "description": "The mapping the run used, as JSON text (a string, not json: jsonb would reorder its keys)"}
      }
    },
    "analysis": {
      "securityMode": "master",
      "delegate": "study_id",
      "friendlyName": "NCA analyses",
      "description": "One NCA analysis: its recipe, workflow state, results summary and a d42 snapshot of its source table; secured by its study",
      "columns": {
        "study_id": {"type": "ref", "ref": "study", "required": true, "onDelete": "cascade", "friendlyName": "Study"},
        "label": {"type": "string", "required": true, "isName": true, "searchable": true, "friendlyName": "Name"},
        "engine_version": {"type": "string", "friendlyName": "Engine version", "description": "sci-comp version of the stored results; null = unknown or never computed"},
        "results_basis": {"type": "string", "friendlyName": "Results basis", "description": "Reporting-basis contract of the stored CL / Vz / Vss (RESULTS_BASIS, e.g. per-kg-1); null = written before the per-kg basis, stale"},
        "has_cache": {"type": "bool", "default": false, "friendlyName": "Has results", "description": "Results were computed (possibly zero analysis_result rows); false = never confirmed"},
        "tier_n_subjects": {"type": "int", "min": 0, "friendlyName": "Subjects"},
        "tier_n_compounds": {"type": "int", "min": 0, "friendlyName": "Compounds"},
        "tier_route": {"type": "string", "friendlyName": "Route", "description": "The modal route of the profiles"},
        "tier_dose": {"type": "string", "friendlyName": "Dose"},
        "tier_status": {"type": "string", "choices": ["ok", "warn", "error"], "friendlyName": "Status"},
        "tier_flag_summary": {"type": "string", "friendlyName": "Flags"},
        "results_computed_at": {"type": "datetime", "friendlyName": "Results computed", "description": "Set only by a write that changes the results"},
        "results_snapshot_hash": {"type": "string", "friendlyName": "Results snapshot hash", "description": "Content hash of the snapshot the results were computed from"},
        "group_keys": {"type": "string_list", "friendlyName": "Group keys", "description": "Group key labels of the results; analysis_result.group_values are in this order"},
        "row_count": {"type": "int", "min": 0, "friendlyName": "Rows"},
        "source_kind": {"type": "string", "required": true, "choices": ["stored", "platformPath", "dbQuery"], "default": "stored", "friendlyName": "Source kind"},
        "source_file": {"type": "file", "friendlyName": "Source snapshot", "description": "file://System:DomainFiles/nca/analysis/<uuid>/source.d42"},
        "source_ref": {"type": "string", "friendlyName": "Source reference", "description": "platformPath: the path; dbQuery: provenance only"},
        "source_sig_kind": {"type": "string", "choices": ["rowcount-mtime", "content-hash", "computed-at-only"], "friendlyName": "Source signature"},
        "source_mtime": {"type": "datetime", "friendlyName": "Source modified"},
        "source_hash": {"type": "string", "friendlyName": "Source hash", "description": "computeSnapshotHash of the stored snapshot"},
        "source_computed_at": {"type": "datetime", "friendlyName": "Source signed at"},
        "recipe": {"type": "json", "required": true, "friendlyName": "Recipe", "description": "AnalysisRecipe; the search columns below are derived from it"},
        "recipe_version": {"type": "int", "required": true, "default": 1, "friendlyName": "Recipe version"},
        "is_sparse": {"type": "bool", "default": false, "friendlyName": "Sparse", "description": "From recipe modes.sparse.on"},
        "sparse_sampling_type": {"type": "string", "choices": ["(auto)", "destructive", "batch", "serial"], "friendlyName": "Sampling type", "description": "From recipe modes.sparse.samplingType; null when not sparse"},
        "auc_method": {"type": "string", "friendlyName": "AUC method", "description": "From recipe ncaRules.aucMethod (sci-comp AucMethod: linear | log-linear | linear-up-log-down)"},
        "blq_pre_first": {"type": "string", "friendlyName": "BLQ before first", "description": "From recipe ncaRules.blq.preFirstMeasurable (sci-comp BlqRule: set-zero | set-half-lloq | exclude | missing)"},
        "blq_embedded": {"type": "string", "friendlyName": "BLQ embedded", "description": "From recipe ncaRules.blq.embedded (sci-comp BlqRule)"},
        "blq_after_last": {"type": "string", "friendlyName": "BLQ after last", "description": "From recipe ncaRules.blq.afterLast (sci-comp BlqRule)"},
        "blq_consecutive": {"type": "string", "friendlyName": "BLQ consecutive after last", "description": "From recipe ncaRules.blq.consecutiveAfterLast (sci-comp BlqRule)"},
        "confirmed_fingerprint": {"type": "string", "friendlyName": "Confirmed fingerprint", "description": "Recipe fingerprint of the last Confirm; null = never confirmed"},
        "confirmed_at": {"type": "datetime", "friendlyName": "Confirmed at"},
        "confirmed_recipe": {"type": "json", "friendlyName": "Confirmed recipe", "description": "The confirmed recipe snapshot, written only when its fingerprint differs from recipe's; null = the recipe itself"},
        "stage": {"type": "string", "choices": ["setup", "review", "complete"], "friendlyName": "Stage", "description": "Derived stage cached for the lists; null = none"},
        "stage_pending": {"type": "int", "min": 0, "friendlyName": "To review"},
        "stage_not_applicable": {"type": "int", "min": 0, "friendlyName": "Not applicable"},
        "origin_kind": {"type": "string", "choices": ["standalone", "pipeline"], "friendlyName": "Origin", "description": "null = made in the app"},
        "origin_label": {"type": "string", "friendlyName": "Moved from container", "description": "standalone: the container's label at move time"},
        "origin_container_id": {"type": "string", "friendlyName": "Moved from container id"},
        "pipeline_run": {"type": "ref", "ref": "pipeline_run", "onDelete": "setnull", "friendlyName": "Pipeline run"},
        "pipeline_partition": {"type": "string", "friendlyName": "Pipeline partition"},
        "pipeline_recipe_hash": {"type": "string", "friendlyName": "Pipeline recipe hash"},
        "pipeline_recipe_hash_version": {"type": "int", "friendlyName": "Pipeline recipe hash version"},
        "pipeline_supersedes": {"type": "string", "friendlyName": "Supersedes", "description": "Id of the pipeline analysis this one superseded (sampling design changed)"},
        "pipeline_flag_count": {"type": "int", "min": 0, "default": 0, "friendlyName": "Pipeline flags", "description": "Profiles with a pipeline-only reason (FIELD-11)"},
        "moved_from_label": {"type": "string", "friendlyName": "Moved from", "description": "Label the analysis had in Ungrouped before a Move (the analyses/<label> redirect)"},
        "updated_at": {"type": "datetime", "friendlyName": "Updated"}
      }
    },
    "analysis_result": {
      "securityMode": "master",
      "delegate": "analysis_id",
      "audit": false,
      "softDelete": false,
      "friendlyName": "NCA analysis results",
      "description": "One results row (CompoundTierRow) of an analysis: mean, %CV and n per parameter",
      "columns": {
        "analysis_id": {"type": "ref", "ref": "analysis", "required": true, "onDelete": "cascade", "friendlyName": "Analysis"},
        "study_id": {"type": "ref", "ref": "study", "required": true, "onDelete": "cascade", "friendlyName": "Study", "description": "Copy of analysis.study_id, for one query per study"},
        "ord": {"type": "int", "required": true, "min": 0, "friendlyName": "Order"},
        "compound_id": {"type": "string", "friendlyName": "Compound"},
        "is_whole_analysis": {"type": "bool", "default": false, "friendlyName": "Whole analysis"},
        "route": {"type": "string", "friendlyName": "Route"},
        "dose_norm": {"type": "string", "choices": ["absolute", "per_kg"], "friendlyName": "Dose normalisation", "description": "The engine's DOSE_NORM (absolute | per_kg), not the reporting basis: cl / vz / vss are per kg on every row"},
        "n": {"type": "int", "min": 0, "friendlyName": "N"},
        "engine_version": {"type": "string", "friendlyName": "Engine version", "description": "Copy of analysis.engine_version"},
        "results_basis": {"type": "string", "friendlyName": "Results basis", "description": "Copy of analysis.results_basis"},
        "cmax_mean": {"type": "float", "friendlyName": "Cmax mean"},
        "cmax_cv": {"type": "float", "friendlyName": "Cmax %CV"},
        "cmax_n": {"type": "int", "friendlyName": "Cmax n"},
        "cmax_n_excluded": {"type": "int", "friendlyName": "Cmax n excluded"},
        "tmax_mean": {"type": "float", "friendlyName": "Tmax mean"},
        "tmax_cv": {"type": "float", "friendlyName": "Tmax %CV"},
        "tmax_n": {"type": "int", "friendlyName": "Tmax n"},
        "tmax_n_excluded": {"type": "int", "friendlyName": "Tmax n excluded"},
        "auc_inf_mean": {"type": "float", "friendlyName": "AUC∞ mean"},
        "auc_inf_cv": {"type": "float", "friendlyName": "AUC∞ %CV"},
        "auc_inf_n": {"type": "int", "friendlyName": "AUC∞ n"},
        "auc_inf_n_excluded": {"type": "int", "friendlyName": "AUC∞ n excluded"},
        "thalf_mean": {"type": "float", "friendlyName": "t½ mean"},
        "thalf_cv": {"type": "float", "friendlyName": "t½ %CV"},
        "thalf_n": {"type": "int", "friendlyName": "t½ n"},
        "thalf_n_excluded": {"type": "int", "friendlyName": "t½ n excluded"},
        "cl_mean": {"type": "float", "friendlyName": "CL mean", "description": "mL/min/kg"},
        "cl_cv": {"type": "float", "friendlyName": "CL %CV"},
        "cl_n": {"type": "int", "friendlyName": "CL n"},
        "cl_n_excluded": {"type": "int", "friendlyName": "CL n excluded"},
        "vz_mean": {"type": "float", "friendlyName": "Vz mean", "description": "L/kg"},
        "vz_cv": {"type": "float", "friendlyName": "Vz %CV"},
        "vz_n": {"type": "int", "friendlyName": "Vz n"},
        "vz_n_excluded": {"type": "int", "friendlyName": "Vz n excluded"},
        "mrt_mean": {"type": "float", "friendlyName": "MRT mean"},
        "mrt_cv": {"type": "float", "friendlyName": "MRT %CV"},
        "mrt_n": {"type": "int", "friendlyName": "MRT n"},
        "mrt_n_excluded": {"type": "int", "friendlyName": "MRT n excluded"},
        "vss_mean": {"type": "float", "friendlyName": "Vss mean", "description": "L/kg"},
        "vss_cv": {"type": "float", "friendlyName": "Vss %CV"},
        "vss_n": {"type": "int", "friendlyName": "Vss n"},
        "vss_n_excluded": {"type": "int", "friendlyName": "Vss n excluded"},
        "pct_extrap_mean": {"type": "float", "friendlyName": "%AUCextrap mean"},
        "pct_extrap_cv": {"type": "float", "friendlyName": "%AUCextrap %CV"},
        "pct_extrap_n": {"type": "int", "friendlyName": "%AUCextrap n"},
        "pct_extrap_n_excluded": {"type": "int", "friendlyName": "%AUCextrap n excluded"},
        "f_pct_mean": {"type": "float", "friendlyName": "%F mean"},
        "f_pct_cv": {"type": "float", "friendlyName": "%F %CV"},
        "f_pct_n": {"type": "int", "friendlyName": "%F n", "description": "null = %F does not apply to this row"},
        "f_pct_n_excluded": {"type": "int", "friendlyName": "%F n excluded"},
        "f_pct_ne": {"type": "bool", "default": false, "friendlyName": "%F not estimable", "description": "Computed, not estimable (no IV reference)"},
        "has_curve": {"type": "bool", "default": false, "friendlyName": "Has curve"},
        "group_values": {"type": "string_list", "friendlyName": "Group values", "description": "In the order of analysis.group_keys"},
        "warning_codes": {"type": "string_list", "friendlyName": "Warning codes"},
        "warning_messages": {"type": "string_list", "friendlyName": "Warnings", "description": "Parallel to warning_codes"},
        "structure": {"type": "string", "semType": "Molecule", "friendlyName": "Structure", "description": "The row's SMILES when a structure annotation has exactly one value; the source is composition"},
        "composition": {"type": "json", "friendlyName": "Composition", "description": "{keyInventory, passthrough}"},
        "curve": {"type": "json", "friendlyName": "Curve", "description": "CompoundCurve; null = no curve"}
      }
    },
    "lz_override": {
      "securityMode": "master",
      "delegate": "analysis_id",
      "friendlyName": "NCA λz overrides",
      "description": "One manual λz point of an analysis",
      "businessKey": ["analysis_id", "profile_key", "time_key", "ordinal"],
      "columns": {
        "analysis_id": {"type": "ref", "ref": "analysis", "required": true, "onDelete": "cascade", "friendlyName": "Analysis"},
        "profile_key": {"type": "string", "required": true, "friendlyName": "Profile"},
        "time_key": {"type": "string", "required": true, "friendlyName": "Time"},
        "ordinal": {"type": "int", "required": true, "min": 0, "friendlyName": "Replicate"},
        "conc_key": {"type": "string", "friendlyName": "Concentration"},
        "action": {"type": "string", "required": true, "choices": ["force-in", "force-out"], "friendlyName": "Action"},
        "set_by": {"type": "user", "friendlyName": "Set by", "description": "The analyst (kept across a save beside); null for a record made without a platform user"},
        "set_by_label": {"type": "string", "friendlyName": "Set by (name)", "description": "The analyst's name as recorded at the time"},
        "set_at": {"type": "datetime", "friendlyName": "Set at"}
      }
    },
    "review_decision": {
      "securityMode": "master",
      "delegate": "analysis_id",
      "softDelete": false,
      "friendlyName": "NCA review decisions",
      "description": "One review decision; append-only: a superseded decision gets superseded_by/at and is never changed otherwise",
      "columns": {
        "analysis_id": {"type": "ref", "ref": "analysis", "required": true, "onDelete": "cascade", "friendlyName": "Analysis"},
        "study_id": {"type": "ref", "ref": "study", "required": true, "onDelete": "cascade", "friendlyName": "Study", "description": "Copy of analysis.study_id, for a per-study listing"},
        "unit_key": {"type": "string", "required": true, "immutable": true, "friendlyName": "Unit", "description": "A subject or sparse:<group>"},
        "action": {"type": "string", "required": true, "immutable": true, "choices": ["accept", "acknowledge", "exclude"], "friendlyName": "Action"},
        "reason_codes": {"type": "string_list", "immutable": true, "friendlyName": "Reason codes"},
        "reason_texts": {"type": "string_list", "immutable": true, "friendlyName": "Reasons", "description": "Parallel to reason_codes"},
        "decided_by": {"type": "user", "immutable": true, "friendlyName": "Decided by", "description": "The analyst (kept across a save beside); null for a record made without a platform user"},
        "decided_by_label": {"type": "string", "immutable": true, "friendlyName": "Decided by (name)", "description": "The analyst's name as recorded at the time"},
        "decided_at": {"type": "datetime", "immutable": true, "friendlyName": "Decided at"},
        "fingerprint": {"type": "string", "immutable": true, "friendlyName": "Fingerprint"},
        "superseded_by": {"type": "string", "choices": ["reset", "auto-reset", "replaced"], "friendlyName": "Superseded by", "description": "null = the current decision of its unit"},
        "superseded_at": {"type": "datetime", "friendlyName": "Superseded at"}
      }
    },
    "pipeline_flag": {
      "securityMode": "master",
      "delegate": "analysis_id",
      "audit": false,
      "softDelete": false,
      "friendlyName": "NCA pipeline flags",
      "description": "One profile's pipeline verdict; a pipeline write replaces the analysis's set",
      "businessKey": ["analysis_id", "profile_key"],
      "columns": {
        "analysis_id": {"type": "ref", "ref": "analysis", "required": true, "onDelete": "cascade", "friendlyName": "Analysis"},
        "profile_key": {"type": "string", "required": true, "friendlyName": "Profile"},
        "verdict": {"type": "string", "required": true, "choices": ["Accepted", "Review"], "friendlyName": "Verdict"},
        "reasons": {"type": "string_list", "friendlyName": "Reasons"},
        "info": {"type": "string_list", "friendlyName": "Info"},
        "pipeline_only": {"type": "string_list", "friendlyName": "Pipeline-only reasons"}
      }
    }
  }
}
