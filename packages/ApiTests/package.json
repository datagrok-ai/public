{
  "name": "@datagrok/api-tests",
  "friendlyName": "API Tests",
  "version": "1.10.3",
  "author": {
    "name": "Alexander Paramonov",
    "email": "aparamonov@datagrok.ai"
  },
  "servicePackage": true,
  "description": "Automated tests for the [Datagrok JS API](https://datagrok.ai/js-api)",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/ApiTests"
  },
  "dependencies": {
    "@datagrok-libraries/domain-ui": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "rxjs": "catalog:",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/wu": "catalog:",
    "@types/yargs": "^17.0.34",
    "root-require": "^0.3.1",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test",
    "stress-node": "node --import tsx --import ./node-test-loader/register.mjs src/package-test-node.ts --apiUrl=http://localhost:8888/api --devKey=admin --mode=stress --concurrencyRange=10-100 --step=5"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "Administrators"
  ],
  "category": "Development",
  "properties": [
    {
      "name": "INT",
      "propertyType": "int",
      "defaultValue": 1,
      "nullable": false
    },
    {
      "name": "FLOAT",
      "propertyType": "double",
      "defaultValue": 1.234,
      "nullable": false
    },
    {
      "name": "BOOL",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    },
    {
      "name": "STRING",
      "propertyType": "string",
      "defaultValue": "value1",
      "nullable": false
    }
  ],
  "optionalDependencies": {
    "yargs": "^18.0.0"
  }
}
