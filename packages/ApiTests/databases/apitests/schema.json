{
  "$schema": "https://datagrok.ai/schemas/domain-schema.schema.json",
  "name": "apitests",
  "version": "1.3.0",
  "tables": {
    "item": {
      "securityMode": "row",
      "businessKey": ["sku"],
      "description": "Fixture table for grok.dapi.domains ApiTests",
      "columns": {
        "sku": {"type": "string", "required": true, "unique": true},
        "name": {"type": "string"},
        "quantity": {"type": "int", "min": 0}
      },
      "schemas": ["item_meta"],
      "relations": {
        "tags": {"via": "item_tag", "target": "tag"}
      }
    },
    "tag": {
      "securityMode": "row",
      "businessKey": ["name"],
      "description": "Relation target for the item ↔ tag many-to-many ApiTests",
      "columns": {
        "name": {"type": "string", "required": true, "unique": true, "isName": true}
      }
    },
    "item_tag": {
      "securityMode": "master",
      "delegate": "item_id",
      "businessKey": ["item_id", "tag_id"],
      "description": "Junction of the item ↔ tag relation; master mode so Edit on the item is Edit on its links",
      "columns": {
        "item_id": {"type": "ref", "ref": "item", "onDelete": "cascade", "required": true},
        "tag_id": {"type": "ref", "ref": "tag", "onDelete": "cascade", "required": true}
      }
    },
    "item_event": {
      "securityMode": "master",
      "delegate": "item_id",
      "description": "Detail table for transaction/$ref and expand ApiTests",
      "columns": {
        "item_id": {"type": "ref", "ref": "item", "onDelete": "cascade", "required": true},
        "kind": {"type": "string", "required": true},
        "amount": {"type": "int"}
      }
    },
    "hidden_item": {
      "securityMode": "row",
      "defaultRowVisibility": "none",
      "description": "Fixture for the reaches-rows rule: a grant on THIS table does not reach its rows",
      "columns": {
        "sku": {"type": "string", "required": true, "unique": true},
        "name": {"type": "string"}
      }
    }
  },
  "propertySchemas": {
    "item_meta": {
      "note": {"type": "string"}
    }
  }
}
