{
  "name": "@datagrok/pyodide",
  "friendlyName": "Pyodide",
  "version": "1.4.1",
  "description": "Provides support of python scripting directly in browser using Pyodide (https://pyodide.org/)",
  "author": {
    "name": "Oleksandra Serhiienko",
    "email": "oserhiienko@datagrok.ai"
  },
  "dependencies": {
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "Compute",
  "meta": {
    "dartium": false,
    "browserFeatures": [
      "wasm"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Pyodide"
  }
}
