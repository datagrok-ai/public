# Developer keys
upload.keys.json

# Local dev-loop harness — never part of a published package. dev/.claude/ holds a copy of the
# developer's Claude subscription credentials; .gitignore alone does NOT keep it out of a publish,
# because ignore-walk skips .gitignore in any directory that has an .npmignore (this one).
dev/

# Dependency directories
node_modules/

# IDEs
# VS Code (https://github.com/github/gitignore/blob/master/Global/VisualStudioCode.gitignore)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Intellij IDEA/WebStorm (https://github.com/github/gitignore/blob/master/Global/JetBrains.gitignore)
.idea/inspectionProfiles/
.idea/**/compiler.xml
.idea/**/encodings.xml
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/codeStyles/


