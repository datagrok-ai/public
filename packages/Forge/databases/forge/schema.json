{
  "$schema": "https://datagrok.ai/schemas/domain-schema.schema.json",
  "name": "forge",
  "version": "0.1.10",
  "tables": {
    "model": {
      "securityMode": "row",
      "promotion": "eager",
      "defaultRowVisibility": "none",
      "friendlyName": "Models",
      "description": "A trained predictive model: everything needed to apply it, plus the training summary shown in the catalog",
      "grants": {"All users": ["view", "edit"]},
      "columns": {
        "name": {"type": "string", "required": true, "isName": true, "searchable": true, "friendlyName": "Name"},
        "description": {"type": "string", "editor": "textarea", "searchable": true, "friendlyName": "Description"},
        "tags": {"type": "string", "friendlyName": "Tags", "description": "Comma-separated tags, shown in the catalog and the model's Details"},
        "engine_name": {"type": "string", "required": true, "friendlyName": "Method", "description": "Method id: the mlname meta of its functions"},
        "engine_namespace": {"type": "string", "required": true, "friendlyName": "Package", "description": "Package of the method's train function, or the namespace of a script method"},
        "engine_kind": {"type": "string", "required": true, "choices": ["function", "script"], "friendlyName": "Method type"},
        "task": {"type": "string", "required": true, "choices": ["regression", "classification"], "friendlyName": "Task"},
        "target_name": {"type": "string", "required": true, "friendlyName": "Target"},
        "target": {"type": "json", "friendlyName": "Target details", "description": "{name, type, semType?, categories?}"},
        "features": {"type": "json", "friendlyName": "Features", "description": "{columns: [{name, type, semType?}]} in training order"},
        "feature_count": {"type": "int", "min": 0, "friendlyName": "Feature count"},
        "options": {"type": "json", "friendlyName": "Preparation", "description": "Preparation replay; keys compatible with the old models: preprocessingInfo, postprocessingInfo, positiveClass, negativeClass, binaryClassificationThreshold, targetType, allowNulls. missingValues: {mode, neighbors?, distance?, skippedRows}; the preprocessingInfo ids ignore-missing and impute-missing record the missing-value handling and are not replayed"},
        "hyperparameters": {"type": "json", "friendlyName": "Hyperparameters", "description": "{<train function input>: value}"},
        "metrics": {"type": "json", "friendlyName": "Metrics", "description": "{train: {<metric id>: number}, validation: {<metric id>: number}, positiveClass?}; ids: mse, rmse, mae, r2, accuracy, f1, sensitivity, specificity, precision, npv (auc reserved, not written yet)"},
        "seed": {"type": "int", "friendlyName": "Seed"},
        "splitting": {"type": "json", "friendlyName": "Data split", "description": "{scheme: none|kfold|holdout, folds?, trainFraction?, isStratified?}"},
        "storage_mode": {"type": "string", "required": true, "choices": ["none", "reference", "copy"], "default": "none", "friendlyName": "Data storage", "description": "What the model keeps of its training data: none (a summary), reference (a link to the source), copy (an uploaded table)"},
        "dataset_name": {"type": "string", "friendlyName": "Table"},
        "row_count": {"type": "int", "min": 0, "friendlyName": "Training rows"},
        "dataset_ref": {"type": "json", "friendlyName": "Data source", "description": "reference mode: {kind: file|query|script, script, path?, id?, name?}; script is the creation script the platform recorded for the table, one call per line"},
        "dataset_table_id": {"type": "string", "friendlyName": "Data copy", "description": "copy mode: id of the training table uploaded on Save (the feature and target columns), deleted with the model; no foreign key"},
        "dataset_fingerprint": {"type": "json", "friendlyName": "Data summary", "description": "{rowCount, columnCount, hash, columns: [{name, type, missingCount, min?, max?, mean?, categories?}]}"},
        "blob": {"type": "file", "friendlyName": "Model file", "description": "file://System:DomainFiles/forge/model/<uuid>/model.bin"},
        "has_training_rows": {"type": "bool", "default": false, "friendlyName": "Contains training rows", "description": "The model file embeds training rows (SVM support vectors); from the method's meta.mlhasrows"},
        "legacy_id": {"type": "string", "unique": true, "friendlyName": "Legacy id", "description": "Id of the migrated core model"}
      },
      "filters": [
        {"column": "engine_name", "label": "Method"},
        {"column": "task", "label": "Task"},
        {"column": "storage_mode", "label": "Data storage"},
        {"column": "created_on", "type": "range", "label": "Created"}
      ]
    },
    "training_run": {
      "securityMode": "row",
      "promotion": "eager",
      "defaultRowVisibility": "none",
      "friendlyName": "Training runs",
      "description": "One training attempt, saved as a model or not",
      "grants": {"All users": ["view", "edit"]},
      "columns": {
        "model_id": {"type": "ref", "ref": "model", "onDelete": "setnull", "friendlyName": "Model"},
        "engine_name": {"type": "string", "required": true, "friendlyName": "Method"},
        "engine_namespace": {"type": "string", "required": true, "friendlyName": "Package"},
        "engine_kind": {"type": "string", "required": true, "choices": ["function", "script"], "friendlyName": "Method type"},
        "task": {"type": "string", "required": true, "choices": ["regression", "classification"], "friendlyName": "Task"},
        "target_name": {"type": "string", "required": true, "friendlyName": "Target"},
        "features": {"type": "json", "friendlyName": "Features"},
        "options": {"type": "json", "friendlyName": "Preparation"},
        "hyperparameters": {"type": "json", "friendlyName": "Hyperparameters"},
        "seed": {"type": "int", "friendlyName": "Seed"},
        "splitting": {"type": "json", "friendlyName": "Data split"},
        "metrics": {"type": "json", "friendlyName": "Metrics"},
        "dataset_name": {"type": "string", "friendlyName": "Table"},
        "row_count": {"type": "int", "min": 0, "friendlyName": "Training rows"},
        "dataset_fingerprint": {"type": "json", "friendlyName": "Data summary"},
        "status": {"type": "string", "required": true, "choices": ["completed", "failed", "cancelled"], "friendlyName": "Status"},
        "error": {"type": "string", "friendlyName": "Error"},
        "started_on": {"type": "datetime", "required": true, "friendlyName": "Started"},
        "duration_ms": {"type": "int", "min": 0, "friendlyName": "Duration (ms)"}
      }
    },
    "application": {
      "securityMode": "master",
      "delegate": "model_id",
      "audit": false,
      "friendlyName": "Applications",
      "description": "One application of a model to a table: who, when, how many rows, the prediction column and the outcome; secured by the model",
      "columns": {
        "model_id": {"type": "ref", "ref": "model", "required": true, "onDelete": "cascade", "friendlyName": "Model"},
        "table_name": {"type": "string", "friendlyName": "Table"},
        "row_count": {"type": "int", "required": true, "min": 0, "friendlyName": "Rows"},
        "skipped_rows": {"type": "int", "min": 0, "friendlyName": "Skipped rows", "description": "Rows left without a prediction because of missing values"},
        "column_name": {"type": "string", "friendlyName": "Prediction column", "description": "Name of the prediction column"},
        "source": {"type": "string", "required": true, "choices": ["ui", "api"], "default": "ui", "friendlyName": "Source"},
        "status": {"type": "string", "required": true, "choices": ["completed", "failed", "cancelled"], "default": "completed", "friendlyName": "Status"},
        "error": {"type": "string", "friendlyName": "Error"},
        "duration_ms": {"type": "int", "min": 0, "friendlyName": "Duration (ms)"}
      }
    }
  }
}
