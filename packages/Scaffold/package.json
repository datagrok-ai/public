    "debug-scaffold-localhost": "webpack && grok publish localhost",
    "release-scaffold-localhost": "webpack && grok publish localhost --release"
  },
  "canEdit": [
    "Developers"
  ],
  "canView": [
    "All users"
  ],
  "repository": {
    "type": "git",
