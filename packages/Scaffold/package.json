{
  "name": "scaffold",
  "friendlyName": "Scaffold",
  "version": "0.0.1",
  "description": "A customizable DMTA workflow skeleton with embedded AIDD — built on Datagrok.",
  "author": {
    "name": "Alex Skalkin",
    "email": "askalkin@datagrok.ai"
  },
  "dependencies": {
    "datagrok-api": "^1.26.0",
    "cash-dom": "^8.1.5",
    "dayjs": "^1.11.13",
    "@datagrok-libraries/test": "^1.1.0"
  },
  "devDependencies": {
    "datagrok-tools": "^5.1.5",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "latest",
    "typescript": "latest"
  },
  "scripts": {
    "debug-scaffold": "webpack && grok publish",
    "release-scaffold": "webpack && grok publish --release",
