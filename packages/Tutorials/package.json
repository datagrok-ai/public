{
  "name": "@datagrok/tutorials",
  "friendlyName": "Tutorials",
  "version": "1.11.4",
  "author": {
    "name": "Dmytro Kovalyov",
    "email": "dkovalyov@datagrok.ai"
  },
  "description": "Learn and explore Datagrok through interactive tutorials and a demo app",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Tutorials"
  },
  "dependencies": {
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/tutorials": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "rxjs": "catalog:",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/wu": "catalog:"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test",
    "check-code-style": "eslint ./src/*.ts",
    "fix-style-errors": "eslint ./src/*.ts --fix"
  },
  "properties": [
    {
      "name": "dataAnalysisTrack",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    },
    {
      "name": "machineLearningTrack",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    },
    {
      "name": "cheminformaticsTrack",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    },
    {
      "name": "bioinformaticsTrack",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    },
    {
      "name": "dataAccessTrack",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    },
    {
      "name": "dataTransformation",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    },
    {
      "name": "scientificComputing",
      "propertyType": "bool",
      "defaultValue": true,
      "nullable": false
    }
  ],
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "General"
}
