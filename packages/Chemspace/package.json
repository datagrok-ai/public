{
  "name": "@datagrok/chemspace",
  "friendlyName": "Enamine ChemSpace",
  "version": "1.2.3",
  "author": {
    "name": "Maria Dolotova",
    "email": "mdolotova@datagrok.ai"
  },
  "fullName": "Chemspace",
  "description": "Integration with Chemspace. Allows to search for molecules available in Chemspace, and provides contextual information for the current molecule.",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Chemspace"
  },
  "dependencies": {
    "@datagrok-libraries/utils": "workspace:^",
    "datagrok-api": "workspace:^",
    "@datagrok-libraries/test": "workspace:^"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test",
    "install-dependencies": "npm install"
  },
  "sources": [
    "css/chemspace.css"
  ],
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "Cheminformatics",
  "meta": {
    "semanticTypes": [
      {
        "semType": "chemspace-id",
        "description": "Compound id in the Chemspace database",
        "parsers": [
          {
            "regexp": "^(CSMS|CSMB|CSCS|CSSB|CSSS)\\d{11}$"
          }
        ]
      }
    ]
  },
  "grok": {
    "testDependencies": [
      "@datagrok/chem"
    ]
  }
}
