{
  "name": "@datagrok/hit-triage",
  "friendlyName": "Hit Triage",
  "version": "1.10.6",
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "description": "Hit Triage helps chemists assess the quality of hits and decide which compounds should make it to the next stage.",
  "sources": [
    "css/hit-triage.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/HitTriage"
  },
  "dependencies": {
    "@datagrok-libraries/bio": "workspace:^",
    "@datagrok-libraries/compute-utils": "workspace:^",
    "@datagrok-libraries/statistics": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "rxjs": "catalog:",
    "typeahead-standalone": "4.14.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.2"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "Cheminformatics",
  "properties": [
    {
      "name": "view",
      "description": "Default User Groups for new campaigns for the 'View' permission",
      "propertyType": "string",
      "defaultValue": "",
      "inputType": "userGroups",
      "nullable": true,
      "category": "DefaultUserGroupsSharing",
      "friendlyName": "View"
    },
    {
      "name": "edit",
      "description": "Default User Groups for new campaigns for the 'Edit' permission",
      "propertyType": "string",
      "defaultValue": "",
      "inputType": "userGroups",
      "nullable": true,
      "category": "DefaultUserGroupsSharing",
      "friendlyName": "Edit"
    },
    {
      "name": "defaultCampaignFolder",
      "description": "Default storage folder for new campaigns",
      "propertyType": "string",
      "defaultValue": "System.AppData/HitTriage",
      "nullable": true,
      "category": "Storage",
      "friendlyName": "Default Campaign Folder"
    }
  ],
  "meta": {
    "sok": "HD_OBSFUS__k7#mP9@zL2$qR5!nX8"
  }
}
