{
  "name": "@datagrok/arrow",
  "friendlyName": "Arrow",
  "version": "1.6.0",
  "author": {
    "name": "Oleksandra Serhiienko",
    "email": "oserhiienko@datagrok.ai"
  },
  "description": "Provides support for the Parquet and Feather file formats.",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Arrow"
  },
  "dependencies": {
    "@datagrok-libraries/arrow": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "apache-arrow": "^21.0.0",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "parquet-wasm": "0.6.1"
  },
  "devDependencies": {
    "path": "^0.12.7"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false,
    "crypto": false
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "Data Access",
  "meta": {
    "dartium": false,
    "browserFeatures": [
      "wasm"
    ]
  }
