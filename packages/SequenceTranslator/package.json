{
  "name": "@datagrok/sequence-translator",
  "friendlyName": "Sequence Translator",
  "version": "1.11.5",
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "description": "SequenceTranslator translates [oligonucleotide](https://en.wikipedia.org/wiki/Oligonucleotide) sequences between [different representations](https://github.com/datagrok-ai/public/tree/master/packages/SequenceTranslator#sequence-representations).",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/SequenceTranslator"
  },
  "properties": [
    {
      "name": "MonomersPath",
      "description": "Path to additional monomer libraries and dictionaries of substituting HELM substructures into sequences",
      "propertyType": "string",
      "defaultValue": "System:AppData/SequenceTranslator/monomers",
      "nullable": false
    },
    {
      "name": "MarkushDefaults",
      "description": "Admin-configured defaults (cores, R-groups, mode and output options) that seed the Markush Enumerator app, as a JSON blob. Distributed per user group by the platform. Leave blank to fall back to the shipped CSV files.",
      "propertyType": "string",
      "nullable": true
    }
  ],
  "dependencies": {
    "@datagrok-libraries/bio": "workspace:^",
    "@datagrok-libraries/chem-meta": "workspace:^",
    "@datagrok-libraries/hwe": "^1.0.0",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/tutorials": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "@types/react": "^18.0.15",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "lodash": "^4.17.21",
    "object-hash": "^3.0.0",
    "openchemlib": "catalog:",
    "save-svg-as-png": "^1.4.17",
    "typeahead-standalone": "4.14.1",
    "wu": "catalog:",
    "rxjs": "catalog:",
    "lru-cache": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/jquery": "^3.5.32",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.202",
    "@types/node-fetch": "^2.6.2",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^18.0.15",
    "@types/wu": "catalog:",
    "typescript-eslint": "^7.2.0"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "Bioinformatics",
  "playwrightTests": "playwright",
  "grok": {
    "testDependencies": [
      "@datagrok/bio",
      "@datagrok/chem",
      "@datagrok/helm"
    ]
  }
}
