{
  "name": "@datagrok/drug-bank",
  "friendlyName": "DrugBank",
  "version": "1.2.0",
  "author": {
    "name": "Maria Dolotova",
    "email": "mdolotova@datagrok.ai"
  },
  "description": "Molecular similarity and substructure search capabilities in the [DrugBank](https://go.drugbank.com/) [Open Structures](https://go.drugbank.com/releases/latest#open-data) dataset.",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/DrugBank"
  },
  "dependencies": {
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "openchemlib": "catalog:",
    "@datagrok-libraries/test": "workspace:^"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test",
    "install-dependencies": "npm install"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "Cheminformatics",
  "sources": [
    "common/openchemlib-full.js"
  ],
  "grok": {
    "testDependencies": [
      "@datagrok/chem"
    ]
  }
