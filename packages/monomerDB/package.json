{
  "name": "@datagrok/monomerdb",
  "friendlyName": "monomerDB",
  "version": "0.0.1",
  "description": "monomerDB description",
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "dependencies": {
    "@datagrok-libraries/bio": "workspace:^",
    "@datagrok-libraries/db-explorer": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@types/wu": "catalog:"
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "canEdit": [
    "Developers"
  ],
  "canView": [
    "All users"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/monomerDB"
  },
  "meta": {
    "semanticTypes": [
      {
        "semType": "DG_MONOMERDB_ID",
        "description": "Monomer Identifier",
        "parsers": [
          {
            "regexp": "GROKMONO-\\d"
          }
        ]
      }
    ]
  }
}
