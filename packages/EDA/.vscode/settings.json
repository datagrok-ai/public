{
  "files.associations": {
    "dense": "cpp"
  },
  "cucumber.features": [
    "bdd/features/**/*.feature"
  ],
  "cucumber.glue": [
    "bdd/bindings/**/*.ts",
    "node_modules/@datagrok-libraries/bdd/bindings/**/*.ts"
  ],
  "cucumber.parameterTypes": [
    {
      "name": "state",
      "regexp": "visible|hidden|present|absent|enabled|disabled|partially checked|checked|unchecked|selected|empty|expanded|collapsed|focused|invalid|valid"
    }
  ]
}
