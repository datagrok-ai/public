{
  "name": "@datagrok/compute2",
  "friendlyName": "Compute2",
  "version": "1.5.10",
  "author": {
    "name": "Andrey Sharapov",
    "email": "andrey.sharapov@softwarecountry.com"
  },
  "description": "Provides modeling UI and Workflows [Documentaion](https://datagrok.ai/help/compute/)",
  "dependencies": {
    "@datagrok-libraries/compute-utils": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "@datagrok-libraries/webcomponents-vue": "workspace:^",
    "@he-tree/vue": "^2.8.7",
    "@types/wu": "catalog:",
    "@vueuse/core": "^13.3.0",
    "@vueuse/rxjs": "^13.3.0",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "exceljs": "catalog:",
    "fflate": "^0.8.2",
    "rxjs": "catalog:",
    "vue": "^3.5.13",
    "vue-json-pretty": "^2.4.0",
    "wu": "catalog:",
    "@he-tree/tree-utils": "^0.1.0-alpha.8"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@types/lodash.isequal": "^4.5.8",
    "@vue/babel-plugin-jsx": "^1.2.4",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.1.1",
    "swc-plugin-transform-vue3-jsx": "^0.2.1",
    "swc-plugin-vue-jsx": "^0.4.0",
    "tailwindcss": "^3.4.13",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.detectors.json && node -e \"require('fs').renameSync('detectors-src.js','detectors.js')\" && grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "properties": [
    {
      "name": "roleOnlyModelFilter",
      "propertyType": "bool",
      "defaultValue": false,
      "nullable": false,
      "description": "Use the faster role-only model filter (drops the legacy #model tag branch)"
    },
    {
      "name": "sharingMethod",
      "propertyType": "string",
      "choices": [
        "none",
        "artifact-alignment",
        "workspaces"
      ],
      "defaultValue": "none",
      "nullable": false,
      "description": "Share action for runs: none — hidden; artifact-alignment — 'Publish to program' (requires the ArtifactAlignment package); workspaces — link the run into an existing space"
    }
  ],
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Compute2"
  },
  "sources": [
    "common/vue.js"
  ],
  "category": "Compute",
  "meta": {
    "url": "/Modelhub",
    "dartium": false
  }
}
