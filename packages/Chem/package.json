{
  "name": "@datagrok/chem",
  "friendlyName": "Chem",
  "fullName": "Chem",
  "version": "1.17.15",
  "author": {
    "name": "Maria Dolotova",
    "email": "mdolotova@datagrok.ai"
  },
  "description": "Cheminformatics support: import, rendering, sketching, calculation of properties, predictive models, augmentations, multiple analyses.",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "packages/Chem"
  },
  "properties": [
    {
      "name": "Sketcher",
      "propertyType": "string",
      "choices": [
        "OpenChemLib",
        "Ketcher",
        "Marvin",
        "ChemDraw"
      ],
      "defaultValue": "Ketcher",
      "nullable": true
    },
    {
      "name": "TemplatesPath",
      "friendlyName": "Default Reactions",
      "category": "Enumeration",
      "description": "File path to the reaction templates CSV (reaction SMARTS) loaded by default in the Reaction Enumerator",
      "propertyType": "string",
      "defaultValue": "System:AppData/Chem/enumerations/reactions.csv",
      "nullable": true
    },
    {
      "name": "BuildingBlocksPath",
      "friendlyName": "Default BBs",
      "category": "Enumeration",
      "description": "File path to the building blocks CSV (SMILES) loaded by default in the Reaction Enumerator",
      "propertyType": "string",
      "defaultValue": "System:AppData/Chem/enumerations/bb.csv",
      "nullable": true
    },
    {
      "name": "ReagentsPath",
      "friendlyName": "Default Reagents",
      "category": "Enumeration",
      "description": "File path to the reagents CSV (SMILES) loaded by default in the Reaction Enumerator; empty for none",
      "propertyType": "string",
      "defaultValue": "",
      "nullable": true
    }
  ],
  "dependencies": {
    "@datagrok-libraries/chem-meta": "workspace:^",
    "@datagrok-libraries/gridext": "workspace:^",
    "@datagrok-libraries/math": "workspace:^",
    "@datagrok-libraries/ml": "workspace:^",
    "@datagrok-libraries/statistics": "workspace:^",
    "@datagrok-libraries/test": "workspace:^",
    "@datagrok-libraries/tutorials": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "@types/pako": "^2.0.3",
    "@webgpu/types": "^0.1.40",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "js-yaml": "^4.1.1",
    "jszip": "3.10.1",
    "ngl": "^2.4.0",
    "offscreen-canvas": "^0.1.1",
    "openchemlib": "catalog:",
    "pako": "^2.1.0",
    "rxjs": "catalog:",
    "typescript-lru-cache": "^2.0.0",
    "worker-loader": "^3.0.8",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/js-yaml": "^4.0.9",
    "@types/offscreencanvas": "^2019.7.3",
    "@types/wu": "catalog:",
    "path": "^0.12.7"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false,
    "crypto": false
  },
  "scripts": {
    "build": "grok build",
    "typecheck": "grok tsc --noEmit -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "grok test"
  },
  "canEdit": [
    "Administrators"
  ],
  "canView": [
    "All users"
  ],
  "category": "Cheminformatics",
  "meta": {
    "dartium": false,
    "browserFeatures": [
      "wasm"
    ]
  },
  "sources": [
    "common/openchemlib-full.js"
  ],
  "playwrightTests": "playwright",
  "grok": {
    "testDependencies": [
      "@datagrok/charts",
      "@datagrok/power-grid"
    ]
  }
}
