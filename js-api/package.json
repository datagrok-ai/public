{
  "name": "datagrok-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "version": "1.27.11",
  "description": "",
  "main": "./datagrok.js",
  "types": "./datagrok.d.ts",
  "files": [
    "datagrok.js",
    "datagrok.js.map",
    "datagrok.d.ts",
    "datagrok.d.ts.map",
    "dg.js",
    "dg.js.map",
    "dg.d.ts",
    "dg.d.ts.map",
    "grok.js",
    "grok.js.map",
    "grok.d.ts",
    "grok.d.ts.map",
    "ui.js",
    "ui.js.map",
    "ui.d.ts",
    "ui.d.ts.map",
    "node-api.js",
    "node-api.js.map",
    "node-api.d.ts",
    "node-api.d.ts.map",
    "node-api.ts",
    "*.datagrok.js",
    "*.datagrok.js.map",
    "src/**/*.js",
    "src/**/*.js.map",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "src/**/*.json",
    "src/**/*.md",
    "src/datagrok/build/web/grok_shared.dart.js",
    "css",
    "README.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONVENTIONS.md"
  ],
  "typesVersions": {
    "*": {
      "grok": [
        "./grok.d.ts"
      ],
      "grok.js": [
        "./grok.d.ts"
      ],
      "ui": [
        "./ui.d.ts"
      ],
      "ui.js": [
        "./ui.d.ts"
      ],
      "dg": [
        "./dg.d.ts"
      ],
      "dg.js": [
        "./dg.d.ts"
      ],
      "node-api": [
        "./node-api.d.ts"
      ],
      "u2core": [
        "./src/u2core/index.d.ts"
      ]
    }
  },
  "exports": {
    "./datagrok": {
      "types": "./datagrok.d.ts",
      "default": "./datagrok.js"
    },
    "./datagrok.js": {
      "types": "./datagrok.d.ts",
      "default": "./datagrok.js"
    },
    "./grok": {
      "types": "./grok.d.ts",
      "default": "./grok.js"
    },
    "./grok.js": {
      "types": "./grok.d.ts",
      "default": "./grok.js"
    },
    "./ui": {
      "types": "./ui.d.ts",
      "default": "./ui.js"
    },
    "./ui.js": {
      "types": "./ui.d.ts",
      "default": "./ui.js"
    },
    "./dg": {
      "types": "./dg.d.ts",
      "default": "./dg.js"
    },
    "./dg.js": {
      "types": "./dg.d.ts",
      "default": "./dg.js"
    },
    "./node-api": {
      "types": "./node-api.d.ts",
      "default": "./node-api.js"
    },
    "./src/const": {
      "types": "./src/const.d.ts",
      "default": "./src/const.js"
    },
    "./src/u2core/bit-array": {
      "types": "./src/u2core/bit-array.d.ts",
      "default": "./src/u2core/bit-array.js"
    },
    "./src/u2core/bit-array.js": {
      "types": "./src/u2core/bit-array.d.ts",
      "default": "./src/u2core/bit-array.js"
    },
    "./u2core": {
      "types": "./src/u2core/index.d.ts",
      "default": "./src/u2core/index.js"
    }
  },
  "dependencies": {
    "@datagrok-libraries/chem-meta": "^1.0.12",
    "@types/wu": "^2.1.44",
    "cash-dom": "^8.1.5",
    "dayjs": "^1.11.10",
    "openchemlib": "^7.2.3",
    "rxjs": "^6.5.5",
    "typeahead-standalone": "4.14.1",
    "ws": "^8.18.2",
    "wu": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.21.4",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^4.20.0",
    "@typescript-eslint/parser": "^4.20.0",
    "babel-loader": "^9.1.2",
    "bufferutil": "^4.0.9",
    "css-loader": "^5.0.0",
    "eslint": "^7.23.0",
    "null-loader": "^4.0.1",
    "source-map-loader": "^4.0.1",
    "style-loader": "^2.0.0",
    "svg-loader": "^0.0.2",
    "ts-loader": "^8.1.0",
    "tui-jsdoc-template": "^1.2.2",
    "typescript": "^4.2.3",
    "utf-8-validate": "^6.0.5",
    "webpack": "^5.64.1",
    "webpack-cli": "^4.6.0"
  },
  "scripts": {
    "link": "npm link",
    "link-all": "npm link @datagrok-libraries/chem-meta",
    "build-ts": "tsc && eslint ./src/*.js ./dg.js ./ui.js ./grok.js --fix",
    "smoke": "node scripts/smoke-bundle.cjs",
    "check-links": "node scripts/check-sample-links.cjs",
    "inventory": "node scripts/inventory.cjs --check",
    "lint": "eslint --ext .ts src ui.ts grok.ts dg.ts",
    "test": "node --test scripts/unit/rect.test.cjs scripts/unit/color.test.cjs scripts/unit/qnum.test.cjs scripts/unit/utils.test.cjs",
    "build-js-api": "git clean -f -X -d ./src && tsc && webpack && npm run smoke",
    "build": "tsc && webpack && npm run smoke",
    "build-docker": "tsc && webpack --config webpack.config.docker.js && npm run smoke",
    "build-node": "webpack --config webpack.config.node.js",
    "build-all": "npm --prefix ./../libraries/chem-meta run build && npm run build"
  }
}
