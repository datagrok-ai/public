{
  "name": "@datagrok-libraries/u2",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Andrew Skalkin",
    "email": "askalkin@datagrok.ai"
  },
  "fullName": "U2",
  "version": "0.1.0",
  "description": "Next-gen Datagrok UI library: design tokens, headless signal-based components, standalone gallery",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "rxjs": "^6.5.5"
  },
  "peerDependencies": {
    "datagrok-api": ">=1.27.10"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.11.0",
    "@typescript-eslint/parser": "^5.11.0",
    "eslint": "^8.18.0",
    "eslint-config-google": "^0.14.0",
    "http-server": "^14.1.1",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "tsc && npm run manifest:check && npm run lint:tokens",
    "prepublishOnly": "npm run build",
    "test": "node --test tests/*.test.js",
    "e2e:local": "node e2e/run.mjs",
    "e2e:boot": "node e2e/boot-smoke.mjs",
    "e2e:stand": "node e2e/designer.stand.spec.mjs",
    "e2e:stand-u2demo": "node e2e/u2demo.stand.spec.mjs",
    "manifest": "node scripts/gen-manifest.mjs",
    "manifest:check": "node scripts/gen-manifest.mjs --check",
    "icons": "node scripts/gen-icon-names.mjs",
    "lint": "eslint src --ext .ts",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint-fix": "eslint src --ext .ts --fix",
    "gallery": "http-server . -c-1 -o /gallery/",
    "link-api": "npm link datagrok-api",
    "link-all": "npm link datagrok-api"
  },
  "canEdit": [
    "Developers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "libraries/u2"
  }
}
