{
  "name": "@datagrok-libraries/u2",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Andrew Skalkin",
    "email": "askalkin@datagrok.ai"
  },
  "fullName": "U2",
  "version": "0.1.0",
  "description": "Next-gen Datagrok UI library: design tokens, headless signal-based components, standalone gallery",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "!**/*.map",
    "css",
    "vendor",
    "docs",
    "manifest.json",
    "CHANGELOG.md",
    "AGENTS.md",
    "tests/dg-stub.mjs",
    "tests/dom-shim.js",
    "tests/layout.mjs",
    "tests/owned-test.js",
    "tests/platform-doubles.mjs",
    "tests/filter-grammar.corpus.json"
  ],
  "dependencies": {
    "@floating-ui/core": "^1.8.0",
    "@floating-ui/dom": "^1.6.0",
    "@floating-ui/utils": "^0.2.12",
    "rxjs": "catalog:"
  },
  "peerDependencies": {
    "datagrok-api": "workspace:^"
  },
  "devDependencies": {
    "datagrok-api": "workspace:^",
    "happy-dom": "21.0.4",
    "http-server": "^14.1.1"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/gen-styles.mjs && grok tsc -p tsconfig.json && npm run manifest:check && npm run lint:tokens",
    "lint": "eslint --ext .ts,.tsx src",
    "prepublishOnly": "npm run build",
    "test": "node scripts/gen-styles.mjs && grok tsc -p tsconfig.json --outDir .test-build && node scripts/run-tests.mjs && node scripts/check-consumer.mjs --all",
    "eval": "node eval/run-graders.mjs",
    "e2e:local": "node e2e/run.mjs",
    "e2e:boot": "node e2e/boot-smoke.mjs",
    "e2e:stand": "node e2e/designer.stand.spec.mjs",
    "e2e:stand-u2demo": "node e2e/u2demo.stand.spec.mjs",
    "manifest": "node scripts/gen-manifest.mjs",
    "manifest:check": "node scripts/gen-manifest.mjs --check",
    "styles": "node scripts/gen-styles.mjs",
    "icons": "node scripts/gen-icon-names.mjs",
    "gallery": "node -e \"import('./e2e/gallery-server.mjs').then(async (m) => console.log((await m.startGalleryServer()).url + '/gallery/'))\"",
    "lint:tokens": "node scripts/check-tokens.mjs"
  },
  "canEdit": [
    "Developers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "libraries/u2"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./dg": {
      "types": "./dist/src/dg/index.d.ts",
      "default": "./dist/src/dg/index.js"
    },
    "./filter": {
      "types": "./dist/src/core/filter/index.d.ts",
      "default": "./dist/src/core/filter/index.js"
    },
    "./dg/filter": {
      "types": "./dist/src/dg/filter/index.d.ts",
      "default": "./dist/src/dg/filter/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./css/icons.css": "./css/icons.css",
    "./css/theme-dark.css": "./css/theme-dark.css",
    "./tests/dg-stub.mjs": "./tests/dg-stub.mjs",
    "./tests/dom-shim.js": "./tests/dom-shim.js",
    "./tests/layout.mjs": "./tests/layout.mjs",
    "./tests/owned-test.js": "./tests/owned-test.js",
    "./tests/platform-doubles.mjs": "./tests/platform-doubles.mjs",
    "./tests/filter-grammar.corpus.json": "./tests/filter-grammar.corpus.json",
    "./src/core/filter": {
      "types": "./dist/src/core/filter/index.d.ts",
      "default": "./dist/src/core/filter/index.js"
    },
    "./src/dg/filter": {
      "types": "./dist/src/dg/filter/index.d.ts",
      "default": "./dist/src/dg/filter/index.js"
    },
    "./src/dg": {
      "types": "./dist/src/dg/index.d.ts",
      "default": "./dist/src/dg/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src/testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    }
  }
}
