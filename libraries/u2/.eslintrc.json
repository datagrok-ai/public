{
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": [
    "google"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "indent": ["error", 2, {"SwitchCase": 1}],
    "max-len": ["error", 120],
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["warn", {"varsIgnorePattern": "^(_|ui$|grok$|DG$)", "argsIgnorePattern": "^_"}],
    "require-jsdoc": "off",
    "valid-jsdoc": "off",
    "spaced-comment": "off",
    "linebreak-style": "off",
    "curly": ["error", "multi-or-nest"],
    "brace-style": ["error", "1tbs", {"allowSingleLine": true}],
    "block-spacing": [2, "always"],
    "comma-dangle": ["error", {
      "arrays": "only-multiline",
      "functions": "never",
      "objects": "only-multiline",
      "imports": "only-multiline"
    }],
    "guard-for-in": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "excludedFiles": ["src/dg/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{
            "name": "datagrok-api",
            "message": "L0-L2 are platform-free: datagrok-api may only be imported under src/dg/ (see core/docs/features/ui2/PLAN.md D3)."
          }],
          "patterns": [{
            "group": ["datagrok-api/*", "!datagrok-api/u2core"],
            "message": "L0-L2 are platform-free: datagrok-api may only be imported under src/dg/ (see core/docs/features/ui2/PLAN.md D3)."
          }]
        }]
      }
    }
  ]
}
