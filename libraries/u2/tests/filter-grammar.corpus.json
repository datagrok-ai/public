{
  "$schema": "u2-filter-corpus/1",
  "readers": ["public/libraries/u2/tests/filter-grammar.test.js",
              "core/shared/grok_shared/test/filter_grammar_corpus_test.dart"],
  "rules": [
    "tree: the Dart FilterParser output for input, compared structurally (5.0 == 5); a {\"$span\": s} matches a Date within 5 s of now + s (h d w m y; m = 31 days, y = 365).",
    "errors: true — both parsers must fail and there is no tree; position is TS-only (the syntax problem's offsets).",
    "canonical is TS-only: format(fromDomainTree(parseTree(input).tree)) === canonical, and the same for canonical itself.",
    "{\"$column\": name}: a bare single-segment name in the value slot of = != < <= > >= is the other column (no dots, no other operator). {\"$param\": name}: a $name value under any operator, inside in (...) lists too; under like/starts/ends the param stays unwrapped — the binder wraps it in %...% when it binds.",
    "`<property> under <value>`: the hierarchy subtree term — {property, operator: \"under\", value}. The value is an id (or a $param); a bare column name and an in-list are refused there.",
    "matches: the `code`s of the fixture rows the filter selects, sorted ascending. Every reader that can evaluate runs the entry against the fixture and compares the sorted list; a reader that cannot (the grok_shared parse-only twin) ignores the key.",
    "An entry carrying matches must not use $param (nothing binds it) or a relative date span (no fixed clock on the server). $column comparisons ARE evaluated.",
    "The fixture is the contract: a reader asserts at start-up that the table it built has exactly the corpus' columns and types, so a fixture change cannot pass on one side and fail silently on the other.",
    "An `under` value that is a fixture row's `code` is that row's id — `under` compares ids, and the corpus cannot spell one; the fixture's `parent` names a row's `code` the same way."
  ],
  "fixture": {
    "table": "thing",
    "hierarchy": true,
    "businessKey": ["code"],
    "columns": {
      "code":      {"type": "string", "required": true, "unique": true},
      "name":      {"type": "string", "isName": true, "searchable": true},
      "age":       {"type": "int"},
      "weight":    {"type": "float"},
      "active":    {"type": "bool"},
      "due":       {"type": "datetime"},
      "parent_id": {"type": "ref", "ref": "thing"}
    },
    "rows": [
      {"code": "a", "name": "aspirin", "age": 30, "weight": 1.5, "active": true, "due": "2026-01-02T00:00:00Z"},
      {"code": "b", "name": "Bandage", "age": 30, "weight": 2.5, "active": false, "due": "2026-03-04T12:00:00Z",
       "parent": "a"}
    ]
  },
  "entries": [
    {"id": "eq-string", "input": "name = \"aspirin\"",
     "tree": [{"property": "name", "operator": "=", "value": "aspirin"}],
     "canonical": "name = \"aspirin\"",
     "matches": ["a"]},
    {"id": "eq-single-quotes", "input": "name = 'aspirin'",
     "tree": [{"property": "name", "operator": "=", "value": "aspirin"}],
     "canonical": "name = \"aspirin\"",
     "matches": ["a"]},
    {"id": "eq-empty-string", "input": "name = \"\"",
     "tree": [{"property": "name", "operator": "=", "value": ""}],
     "canonical": "name = \"\"",
     "matches": []},
    {"id": "ne-number", "input": "age != 5",
     "tree": [{"property": "age", "operator": "!=", "value": 5}],
     "canonical": "age != 5",
     "matches": ["a", "b"]},
    {"id": "gt", "input": "age > 30",
     "tree": [{"property": "age", "operator": ">", "value": 30}],
     "canonical": "age > 30",
     "matches": []},
    {"id": "gte", "input": "age >= 30",
     "tree": [{"property": "age", "operator": ">=", "value": 30}],
     "canonical": "age >= 30",
     "matches": ["a", "b"]},
    {"id": "lt", "input": "age < 30",
     "tree": [{"property": "age", "operator": "<", "value": 30}],
     "canonical": "age < 30",
     "matches": []},
    {"id": "lte", "input": "age <= 30",
     "tree": [{"property": "age", "operator": "<=", "value": 30}],
     "canonical": "age <= 30",
     "matches": ["a", "b"]},
    {"id": "gt-string", "input": "name > \"m\"",
     "tree": [{"property": "name", "operator": ">", "value": "m"}],
     "canonical": "name > \"m\""},
    {"id": "like", "input": "name like \"asp\"",
     "tree": [{"property": "name", "operator": "like", "value": "%asp%"}],
     "canonical": "name like \"asp\"",
     "matches": ["a"]},
    {"id": "like-percent-inside", "input": "name like \"50%\"",
     "tree": [{"property": "name", "operator": "like", "value": "%50%%"}],
     "canonical": "name like \"50%\""},
    {"id": "like-escaped-underscore", "input": "login like \"john\\\\_doe\"",
