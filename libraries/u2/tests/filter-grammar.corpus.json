{
  "$schema": "u2-filter-corpus/1",
  "readers": ["public/libraries/u2/tests/filter-grammar.test.js",
              "core/shared/grok_shared/test/filter_grammar_corpus_test.dart"],
  "rules": [
    "tree: the Dart FilterParser output for input, compared structurally (5.0 == 5); a {\"$span\": s} matches a Date within 5 s of now + s (h d w m y; m = 31 days, y = 365).",
    "errors: true — both parsers must fail and there is no tree; position is TS-only (the syntax problem's offsets).",
    "canonical is TS-only: format(fromDomainTree(parseTree(input).tree)) === canonical, and the same for canonical itself."
  ],
  "entries": [
    {"id": "eq-string", "input": "name = \"aspirin\"",
     "tree": [{"property": "name", "operator": "=", "value": "aspirin"}],
     "canonical": "name = \"aspirin\""},
    {"id": "eq-single-quotes", "input": "name = 'aspirin'",
     "tree": [{"property": "name", "operator": "=", "value": "aspirin"}],
     "canonical": "name = \"aspirin\""},
    {"id": "eq-empty-string", "input": "name = \"\"",
     "tree": [{"property": "name", "operator": "=", "value": ""}],
     "canonical": "name = \"\""},
    {"id": "ne-number", "input": "age != 5",
     "tree": [{"property": "age", "operator": "!=", "value": 5}],
     "canonical": "age != 5"},
    {"id": "gt", "input": "age > 30",
     "tree": [{"property": "age", "operator": ">", "value": 30}],
     "canonical": "age > 30"},
    {"id": "gte", "input": "age >= 30",
     "tree": [{"property": "age", "operator": ">=", "value": 30}],
     "canonical": "age >= 30"},
    {"id": "lt", "input": "age < 30",
     "tree": [{"property": "age", "operator": "<", "value": 30}],
     "canonical": "age < 30"},
    {"id": "lte", "input": "age <= 30",
     "tree": [{"property": "age", "operator": "<=", "value": 30}],
     "canonical": "age <= 30"},
    {"id": "gt-string", "input": "name > \"m\"",
     "tree": [{"property": "name", "operator": ">", "value": "m"}],
     "canonical": "name > \"m\""},
    {"id": "like", "input": "name like \"asp\"",
     "tree": [{"property": "name", "operator": "like", "value": "%asp%"}],
     "canonical": "name like \"asp\""},
    {"id": "like-percent-inside", "input": "name like \"50%\"",
     "tree": [{"property": "name", "operator": "like", "value": "%50%%"}],
     "canonical": "name like \"50%\""},
    {"id": "like-escaped-underscore", "input": "login like \"john\\\\_doe\"",
     "tree": [{"property": "login", "operator": "like", "value": "%john\\_doe%"}],
     "canonical": "login like \"john\\\\_doe\""},
    {"id": "like-number", "input": "x like 5",
     "tree": [{"property": "x", "operator": "like", "value": "%5%"}],
     "canonical": "x like \"5\""},
    {"id": "like-double-literal", "input": "x like 5.0",
     "tree": [{"property": "x", "operator": "like", "value": "%5.0%"}],
     "canonical": "x like \"5.0\""},
    {"id": "starts", "input": "name starts \"asp\"",
     "tree": [{"property": "name", "operator": "like", "value": "asp%"}],
     "canonical": "name starts \"asp\""},
    {"id": "ends", "input": "name ends \"rin\"",
     "tree": [{"property": "name", "operator": "like", "value": "%rin"}],
     "canonical": "name ends \"rin\""},
    {"id": "not-like", "input": "name !like \"asp\"",
     "tree": [{"property": "name", "operator": "not like", "value": "%asp%"}],
     "canonical": "name !like \"asp\""},
    {"id": "matches", "input": "name matches \"^a.*\"",
     "tree": [{"property": "name", "operator": "~*", "value": "^a.*"}],
     "canonical": "name matches \"^a.*\""},
    {"id": "tilde", "input": "name ~ \"^a\"",
     "tree": [{"property": "name", "operator": "~*", "value": "^a"}],
     "canonical": "name matches \"^a\""},
    {"id": "not-matches", "input": "name !matches \"x\"",
     "tree": [{"property": "name", "operator": "!~*", "value": "x"}],
     "canonical": "name !matches \"x\""},
    {"id": "bang-tilde", "input": "name !~ \"x\"",
     "tree": [{"property": "name", "operator": "!~*", "value": "x"}],
     "canonical": "name !matches \"x\""},
    {"id": "in", "input": "status in (\"Open\", \"Closed\")",
     "tree": [{"property": "status", "operator": "=", "value": ["Open", "Closed"]}],
     "canonical": "status in (\"Open\", \"Closed\")"},
    {"id": "in-mixed", "input": "x in (1, \"a\", true, null)",
     "tree": [{"property": "x", "operator": "=", "value": [1, "a", true, null]}],
     "canonical": "x in (1, \"a\", true, null)"},
    {"id": "in-numbers", "input": "n in (-1, 2.5, 3)",
     "tree": [{"property": "n", "operator": "=", "value": [-1, 2.5, 3]}],
     "canonical": "n in (-1, 2.5, 3)"},
    {"id": "in-no-space-bracket-name", "input": "[Content-Type]  in(\"image/jpeg\")",
     "tree": [{"property": "[Content-Type]", "operator": "=", "value": ["image/jpeg"]}],
     "canonical": "[Content-Type] in (\"image/jpeg\")"},
    {"id": "not-in", "input": "status not in (\"Open\")",
     "tree": [{"property": "status", "operator": "!=", "value": ["Open"]}],
     "canonical": "status not in (\"Open\")"},
    {"id": "bang-in", "input": "status !in (\"Open\", \"Closed\")",
     "tree": [{"property": "status", "operator": "!=", "value": ["Open", "Closed"]}],
     "canonical": "status not in (\"Open\", \"Closed\")"},
    {"id": "fuzzy", "input": "name fuzzy \"Jon\"",
     "tree": [[{"property": "name", "operator": "fuzzy", "threshold": null, "value": "Jon"}, "or",
               {"property": "name", "operator": "like", "value": "%Jon%"}]],
     "canonical": "name fuzzy \"Jon\""},
    {"id": "fuzzy-threshold", "input": "name fuzzy(0.6) \"Jon Doe\"",
     "tree": [[{"property": "name", "operator": "fuzzy", "threshold": 0.6, "value": "Jon Doe"}, "or",
               {"property": "name", "operator": "like", "value": "%Jon Doe%"}]],
     "canonical": "name fuzzy(0.6) \"Jon Doe\""},
    {"id": "fuzzy-tilde-eq", "input": "name ~= \"Jon\"",
     "tree": [[{"property": "name", "operator": "fuzzy", "threshold": null, "value": "Jon"}, "or",
               {"property": "name", "operator": "like", "value": "%Jon%"}]],
     "canonical": "name fuzzy \"Jon\""},
    {"id": "fuzzy-dotted", "input": "author.name fuzzy(0.8) \"John Smith\"",
     "tree": [[{"property": "author.name", "operator": "fuzzy", "threshold": 0.8, "value": "John Smith"}, "or",
               {"property": "author.name", "operator": "like", "value": "%John Smith%"}]],
     "canonical": "author.name fuzzy(0.8) \"John Smith\""},
    {"id": "fuzzy-and", "input": "name fuzzy(0.7) \"Jon\" and age > 21",
     "tree": [[{"property": "name", "operator": "fuzzy", "threshold": 0.7, "value": "Jon"}, "or",
               {"property": "name", "operator": "like", "value": "%Jon%"}], "and",
              {"property": "age", "operator": ">", "value": 21}],
     "canonical": "name fuzzy(0.7) \"Jon\" and age > 21"},
    {"id": "not-prop", "input": "not hidden",
     "tree": [{"property": "hidden", "operator": "=", "value": false}],
     "canonical": "hidden = false"},
    {"id": "not-props-chain",
     "input": "shortname = \"administrators\" and not personal and not hidden and id != \"1ab8\" ",
     "tree": [{"property": "shortname", "operator": "=", "value": "administrators"}, "and",
              {"property": "personal", "operator": "=", "value": false}, "and",
              {"property": "hidden", "operator": "=", "value": false}, "and",
              {"property": "id", "operator": "!=", "value": "1ab8"}],
     "canonical": "shortname = \"administrators\" and personal = false and hidden = false and id != \"1ab8\""},
    {"id": "tag", "input": "#chem",
     "tree": [{"property": "entityTags.tag", "operator": "=", "value": "chem"}],
     "canonical": "entityTags.tag = \"chem\""},
    {"id": "tag-and-like", "input": "name like \"x\" and #chem",
     "tree": [{"property": "name", "operator": "like", "value": "%x%"}, "and",
              {"property": "entityTags.tag", "operator": "=", "value": "chem"}],
     "canonical": "name like \"x\" and entityTags.tag = \"chem\""},
    {"id": "bool-true", "input": "active = true",
     "tree": [{"property": "active", "operator": "=", "value": true}],
     "canonical": "active = true"},
    {"id": "bool-false", "input": "active = false",
     "tree": [{"property": "active", "operator": "=", "value": false}],
     "canonical": "active = false"},
    {"id": "null", "input": "x = null",
     "tree": [{"property": "x", "operator": "=", "value": null}],
     "canonical": "x = null"},
    {"id": "not-null", "input": "x != null",
     "tree": [{"property": "x", "operator": "!=", "value": null}],
     "canonical": "x != null"},
    {"id": "current", "input": "owner = @current",
     "tree": [{"property": "owner", "operator": "=", "value": "@current"}],
     "canonical": "owner = @current"},
    {"id": "int", "input": "n = 5",
     "tree": [{"property": "n", "operator": "=", "value": 5}],
     "canonical": "n = 5"},
    {"id": "float-whole", "input": "n = 5.0",
     "tree": [{"property": "n", "operator": "=", "value": 5.0}],
     "canonical": "n = 5"},
    {"id": "float", "input": "mw = 180.16",
     "tree": [{"property": "mw", "operator": "=", "value": 180.16}],
     "canonical": "mw = 180.16"},
    {"id": "negative", "input": "n = -3",
     "tree": [{"property": "n", "operator": "=", "value": -3}],
     "canonical": "n = -3"},
    {"id": "exponent", "input": "x = 1e3",
     "tree": [{"property": "x", "operator": "=", "value": 1000}],
     "canonical": "x = 1000"},
    {"id": "exponent-fraction", "input": "x = 1.5e2",
     "tree": [{"property": "x", "operator": "=", "value": 150.0}],
     "canonical": "x = 150"},
    {"id": "number-k", "input": "size > 5k",
     "tree": [{"property": "size", "operator": ">", "value": 5000.0}],
     "canonical": "size > 5000"},
    {"id": "number-k-fraction", "input": "size <= 1.5k",
     "tree": [{"property": "size", "operator": "<=", "value": 1500.0}],
     "canonical": "size <= 1500"},
    {"id": "number-KB", "input": "size >= 1KB",
     "tree": [{"property": "size", "operator": ">=", "value": 1024.0}],
     "canonical": "size >= 1024"},
    {"id": "number-MB", "input": "size < 2MB",
     "tree": [{"property": "size", "operator": "<", "value": 2097152.0}],
     "canonical": "size < 2097152"},
    {"id": "span-negative", "input": "created > -1w",
     "tree": [{"property": "created", "operator": ">", "value": {"$span": "-1w"}}],
     "canonical": "created > -1w"},
    {"id": "span-now", "input": "created <= now",
     "tree": [{"property": "created", "operator": "<=", "value": {"$span": "now"}}],
     "canonical": "created <= now"},
    {"id": "span-flip-lt", "input": "created < 1h",
     "tree": [{"property": "created", "operator": ">", "value": {"$span": "-1h"}}],
     "canonical": "created > -1h"},
    {"id": "span-flip-lte", "input": "created <= 2d",
     "tree": [{"property": "created", "operator": ">=", "value": {"$span": "-2d"}}],
     "canonical": "created >= -2d"},
    {"id": "span-flip-gt", "input": "created > 3w",
     "tree": [{"property": "created", "operator": "<", "value": {"$span": "-3w"}}],
     "canonical": "created < -3w"},
    {"id": "span-flip-gte", "input": "created >= 1m",
     "tree": [{"property": "created", "operator": "<=", "value": {"$span": "-1m"}}],
     "canonical": "created <= -1m"},
    {"id": "span-flip-eq", "input": "created = 1y",
     "tree": [{"property": "created", "operator": "=", "value": {"$span": "-1y"}}],
     "canonical": "created = -1y"},
    {"id": "span-zero", "input": "created < 0h",
     "tree": [{"property": "created", "operator": "<", "value": {"$span": "0h"}}],
     "canonical": "created < 0h"},
    {"id": "and", "input": "a = 1 and b = 2",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "and", {"property": "b", "operator": "=", "value": 2}],
     "canonical": "a = 1 and b = 2"},
    {"id": "and-double-amp", "input": "a = 1 && b = 2",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "and", {"property": "b", "operator": "=", "value": 2}],
     "canonical": "a = 1 and b = 2"},
    {"id": "and-amp", "input": "a = 1 & b = 2",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "and", {"property": "b", "operator": "=", "value": 2}],
     "canonical": "a = 1 and b = 2"},
    {"id": "or", "input": "a = 1 or b = 2",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "or", {"property": "b", "operator": "=", "value": 2}],
     "canonical": "a = 1 or b = 2"},
    {"id": "or-double-pipe", "input": "a = 1 || b = 2",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "or", {"property": "b", "operator": "=", "value": 2}],
     "canonical": "a = 1 or b = 2"},
    {"id": "or-pipe", "input": "a = 1 | b = 2",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "or", {"property": "b", "operator": "=", "value": 2}],
     "canonical": "a = 1 or b = 2"},
    {"id": "juxtaposition", "input": "a = 1 b = 2",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "and", {"property": "b", "operator": "=", "value": 2}],
     "canonical": "a = 1 and b = 2"},
    {"id": "juxtaposition-paren", "input": "a = 1 (b = 2)",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "and", [{"property": "b", "operator": "=", "value": 2}]],
     "canonical": "a = 1 and b = 2"},
    {"id": "paren-single", "input": "(a = 1)",
     "tree": [[{"property": "a", "operator": "=", "value": 1}]],
     "canonical": "a = 1"},
    {"id": "paren-group", "input": "a = 1 and (b = 2 or c = 3)",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "and",
              [{"property": "b", "operator": "=", "value": 2}, "or", {"property": "c", "operator": "=", "value": 3}]],
     "canonical": "a = 1 and (b = 2 or c = 3)"},
    {"id": "paren-nested", "input": "((a = 1 or b = 2))",
     "tree": [[[{"property": "a", "operator": "=", "value": 1}, "or", {"property": "b", "operator": "=", "value": 2}]]],
     "canonical": "a = 1 or b = 2"},
    {"id": "mixed-flat-or-first", "input": "a = 1 or b = 2 and c = 3",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "or", {"property": "b", "operator": "=", "value": 2}, "and",
              {"property": "c", "operator": "=", "value": 3}],
     "canonical": "a = 1 or (b = 2 and c = 3)"},
    {"id": "mixed-flat-and-first", "input": "a = 1 and b = 2 or c = 3",
     "tree": [{"property": "a", "operator": "=", "value": 1}, "and", {"property": "b", "operator": "=", "value": 2}, "or",
              {"property": "c", "operator": "=", "value": 3}],
     "canonical": "(a = 1 and b = 2) or c = 3"},
    {"id": "between-numbers", "input": "age between 18 and 65",
     "tree": [[{"property": "age", "operator": ">=", "value": 18}, "and", {"property": "age", "operator": "<=", "value": 65}]],
     "canonical": "age between 18 and 65"},
    {"id": "between-strings", "input": "name between \"a\" and \"m\"",
     "tree": [[{"property": "name", "operator": ">=", "value": "a"}, "and", {"property": "name", "operator": "<=", "value": "m"}]],
     "canonical": "name between \"a\" and \"m\""},
    {"id": "between-spans", "input": "created between -1w and now",
     "tree": [[{"property": "created", "operator": ">=", "value": {"$span": "-1w"}}, "and",
               {"property": "created", "operator": "<=", "value": {"$span": "now"}}]],
     "canonical": "created between -1w and now"},
    {"id": "between-positive-spans-literal", "input": "created between 1d and 2d",
     "tree": [[{"property": "created", "operator": ">=", "value": {"$span": "1d"}}, "and",
               {"property": "created", "operator": "<=", "value": {"$span": "2d"}}]],
     "canonical": "created between 1d and 2d"},
    {"id": "between-and-more", "input": "age between 18 and 65 and sex = \"F\"",
     "tree": [[{"property": "age", "operator": ">=", "value": 18}, "and", {"property": "age", "operator": "<=", "value": 65}],
              "and", {"property": "sex", "operator": "=", "value": "F"}],
     "canonical": "age between 18 and 65 and sex = \"F\""},
    {"id": "not-group-simple", "input": "not (a = 1)",
     "tree": [{"property": "a", "operator": "!=", "value": 1}],
     "canonical": "a != 1"},
    {"id": "not-group-or", "input": "not (a = 1 or b like \"x\")",
     "tree": [[{"property": "a", "operator": "!=", "value": 1}, "and",
               {"property": "b", "operator": "not like", "value": "%x%"}]],
     "canonical": "a != 1 and b !like \"x\""},
    {"id": "not-group-compare", "input": "not (a > 1 and b <= 2)",
     "tree": [[{"property": "a", "operator": "<=", "value": 1}, "or", {"property": "b", "operator": ">", "value": 2}]],
     "canonical": "a <= 1 or b > 2"},
    {"id": "not-group-in", "input": "not (x in (1, 2))",
     "tree": [{"property": "x", "operator": "!=", "value": [1, 2]}],
     "canonical": "x not in (1, 2)"},
    {"id": "not-group-starts", "input": "not (name starts \"a\")",
     "tree": [{"property": "name", "operator": "not like", "value": "a%"}],
     "canonical": "name !like \"a%\""},
    {"id": "not-group-fuzzy", "input": "not (name fuzzy \"x\")",
     "tree": [{"property": "name", "operator": "not like", "value": "%x%"}],
     "canonical": "name !like \"x\""},
    {"id": "not-group-regex", "input": "not (name matches \"x\" or code !~ \"y\")",
     "tree": [[{"property": "name", "operator": "!~*", "value": "x"}, "and", {"property": "code", "operator": "~*", "value": "y"}]],
     "canonical": "name !matches \"x\" and code matches \"y\""},
    {"id": "not-group-nested", "input": "not (a = 1 and (b = 2 or c = 3))",
     "tree": [[{"property": "a", "operator": "!=", "value": 1}, "or",
               [{"property": "b", "operator": "!=", "value": 2}, "and", {"property": "c", "operator": "!=", "value": 3}]]],
     "canonical": "a != 1 or (b != 2 and c != 3)"},
    {"id": "not-group-double", "input": "not (not (a = 1))",
     "tree": [{"property": "a", "operator": "=", "value": 1}],
     "canonical": "a = 1"},
    {"id": "not-group-paren-inside", "input": "not ((a = 1))",
     "tree": [[{"property": "a", "operator": "!=", "value": 1}]],
     "canonical": "a != 1"},
    {"id": "not-group-between", "input": "not (age between 18 and 65)",
     "tree": [[{"property": "age", "operator": "<", "value": 18}, "or", {"property": "age", "operator": ">", "value": 65}]],
     "canonical": "age < 18 or age > 65"},
    {"id": "not-group-tag", "input": "not (#chem)",
     "tree": [{"property": "entityTags.tag", "operator": "!=", "value": "chem"}],
     "canonical": "entityTags.tag != \"chem\""},
    {"id": "not-group-not-prop", "input": "not (not hidden)",
     "tree": [{"property": "hidden", "operator": "!=", "value": false}],
     "canonical": "hidden != false"},
    {"id": "not-group-after-paren", "input": "(a = 1 or b = 2) and not (c = 3)",
     "tree": [[{"property": "a", "operator": "=", "value": 1}, "or", {"property": "b", "operator": "=", "value": 2}], "and",
              {"property": "c", "operator": "!=", "value": 3}],
     "canonical": "(a = 1 or b = 2) and c != 3"},
    {"id": "not-group-escapes-between",
     "input": "not (title = \"d\\'Asie\" or [Mol Weight] between 200 and 500)",
     "tree": [[{"property": "title", "operator": "!=", "value": "d'Asie"}, "and",
               [{"property": "[Mol Weight]", "operator": "<", "value": 200}, "or",
