     "canonical": "title != \"d\\'Asie\" and ([Mol Weight] < 200 or [Mol Weight] > 500)"},
    {"id": "escape-quote", "input": "name = \"say \\\"hi\\\"\"",
     "tree": [{"property": "name", "operator": "=", "value": "say \"hi\""}],
     "canonical": "name = \"say \\\"hi\\\"\""},
    {"id": "escape-backslash", "input": "path = \"a\\\\b\"",
     "tree": [{"property": "path", "operator": "=", "value": "a\\b"}],
     "canonical": "path = \"a\\\\b\""},
    {"id": "escape-apostrophe", "input": "name = \"d\\'Asie\"",
     "tree": [{"property": "name", "operator": "=", "value": "d'Asie"}],
     "canonical": "name = \"d\\'Asie\""},
    {"id": "escape-controls", "input": "s = \"a\\nb\\tc\"",
     "tree": [{"property": "s", "operator": "=", "value": "a\nb\tc"}],
     "canonical": "s = \"a\\nb\\tc\""},
    {"id": "escape-slash", "input": "p = \"a\\/b\"",
     "tree": [{"property": "p", "operator": "=", "value": "a/b"}],
     "canonical": "p = \"a/b\""},
    {"id": "escape-unicode", "input": "region = \"d\\u0027Asie\"",
     "tree": [{"property": "region", "operator": "=", "value": "d'Asie"}],
     "canonical": "region = \"d\\'Asie\""},
    {"id": "string-punctuation", "input": "q = \"a, b (c) and d\"",
     "tree": [{"property": "q", "operator": "=", "value": "a, b (c) and d"}],
     "canonical": "q = \"a, b (c) and d\""},
    {"id": "string-apostrophe-inside", "input": "name = \"it's\"",
     "tree": [{"property": "name", "operator": "=", "value": "it's"}],
     "canonical": "name = \"it\\'s\""},
    {"id": "string-double-quote-inside", "input": "name = 'say \"hi\"'",
     "tree": [{"property": "name", "operator": "=", "value": "say \"hi\""}],
     "canonical": "name = \"say \\\"hi\\\"\""},
    {"id": "err-mixed-quotes", "input": "name = \"abc'", "errors": true, "position": {"start": 12, "end": 12}},
    {"id": "name-bracket", "input": "[Mol Weight] > 200",
     "tree": [{"property": "[Mol Weight]", "operator": ">", "value": 200}],
     "canonical": "[Mol Weight] > 200"},
    {"id": "name-bracket-escaped-close", "input": "[a\\]b] = 1",
     "tree": [{"property": "[a\\]b]", "operator": "=", "value": 1}],
     "canonical": "[a\\]b] = 1"},
    {"id": "name-bracket-backslash", "input": "[a\\\\b] = 1",
     "tree": [{"property": "[a\\\\b]", "operator": "=", "value": 1}],
     "canonical": "[a\\\\b] = 1"},
    {"id": "name-dotted", "input": "author.login = \"x\"",
