{
  "name": "@datagrok-libraries/domain-ui",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Datagrok",
    "email": "info@datagrok.ai"
  },
  "friendlyName": "Domain UI",
  "version": "0.1.0",
  "description": "Composable UI components for entity-mapped domain tables (grok.dapi.domains)",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "libraries/domain-ui"
  },
  "dependencies": {
    "datagrok-api": "workspace:^",
    "rxjs": "catalog:"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
