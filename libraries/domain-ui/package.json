{
  "name": "@datagrok-libraries/domain-ui",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Datagrok",
    "email": "info@datagrok.ai"
  },
  "friendlyName": "Domain UI",
  "version": "0.1.0",
  "description": "Composable UI components for entity-mapped domain tables (grok.dapi.domains)",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "libraries/domain-ui"
  },
  "dependencies": {
    "datagrok-api": "^1.27.0",
    "rxjs": "^6.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^5.11.0",
    "@typescript-eslint/parser": "^5.11.0",
    "datagrok-tools": "^4.14.34",
    "eslint": "^8.18.0",
    "eslint-config-google": "^0.14.0",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "link": "npm link",
    "link-api": "npm link datagrok-api",
    "link-all": "npm link datagrok-api",
    "build-domain-ui": "git clean -f -X -d ./src && tsc",
    "build": "grok check --soft && tsc",
    "lint": "eslint \"./src/**/*.ts\"",
    "lint-fix": "eslint \"./src/**/*.ts\" --fix",
    "build-all": "npm --prefix ./../../js-api run build && npm run build"
  }
}
