{
  "env": {
    "browser": true,
    "es6": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "indent": ["error", 2, {"SwitchCase": 1}],
    "max-len": ["error", 120],
    "semi": ["error", "always"],
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["warn", {"varsIgnorePattern": "^(_|ui$|grok$|DG$)", "argsIgnorePattern": "^_"}]
  }
}
