{
  "name": "@datagrok-libraries/ml",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "friendlyName": "Datagrok ML library",
  "version": "6.10.16",
  "description": "Machine learning supporting utilities",
  "dependencies": {
    "@datagrok-libraries/math": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "@keckelt/tsne": "^1.0.2",
    "@types/seedrandom": "^3.0.8",
    "@webgpu/types": "^0.1.40",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "fastest-levenshtein": "^1.0.12",
    "graphology": "^0.25.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "jaro-winkler-typescript": "^1.0.1",
    "ml-levenberg-marquardt": "^2.0.0",
    "rxjs": "catalog:",
    "seedrandom": "^3.0.5",
    "umap-js": "^1.3.3",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/ml-levenberg-marquardt": "^3.1.0",
    "@types/wu": "catalog:"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./src/distance-matrix": {
      "types": "./dist/src/distance-matrix/index.d.ts",
      "default": "./dist/src/distance-matrix/index.js"
    },
    "./src/macromolecule-distance-functions": {
      "types": "./dist/src/macromolecule-distance-functions/index.d.ts",
      "default": "./dist/src/macromolecule-distance-functions/index.js"
    },
    "./src/MCL": {
      "types": "./dist/src/MCL/index.d.ts",
      "default": "./dist/src/MCL/index.js"
    },
    "./src/typed-metrics": {
      "types": "./dist/src/typed-metrics/index.d.ts",
      "default": "./dist/src/typed-metrics/index.js"
    },
    "./src/umap": {
      "types": "./dist/src/umap/index.d.ts",
      "default": "./dist/src/umap/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
