{
  "name": "@datagrok-libraries/sci-comp",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "author": {
    "name": "Viktor Makarichev",
    "email": "vmakarichev@datagrok.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "version": "0.10.0",
  "friendlyName": "Scientific Computing",
  "description": "Pure TypeScript library for numerical methods",
  "keywords": [
    "optimization",
    "time series features",
    "statistics"
  ],
  "dependencies": {
    "jstat": "^1.9.6"
  },
  "devDependencies": {
    "@datagrok-libraries/codegen-async-to-sync": "workspace:^",
    "@types/jest": "^29.0.0",
    "@types/wu": "catalog:",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.28.14"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "update-codegen": "codegen-async-to-sync --roots src",
    "codegen:check": "codegen-async-to-sync --check --roots src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./src/nca/core": {
      "types": "./dist/src/nca/core/index.d.ts",
      "default": "./dist/src/nca/core/index.js"
    },
    "./src/nca": {
      "types": "./dist/src/nca/index.d.ts",
      "default": "./dist/src/nca/index.js"
    },
    "./src/optimization": {
      "types": "./dist/src/optimization/index.d.ts",
      "default": "./dist/src/optimization/index.js"
    },
    "./src/optimization/multi-objectives": {
      "types": "./dist/src/optimization/multi-objectives/index.d.ts",
      "default": "./dist/src/optimization/multi-objectives/index.js"
    },
    "./src/optimization/single-objective": {
      "types": "./dist/src/optimization/single-objective/index.d.ts",
      "default": "./dist/src/optimization/single-objective/index.js"
    },
    "./src/optimization/single-objective/optimizers/lbfgs-b": {
      "types": "./dist/src/optimization/single-objective/optimizers/lbfgs-b/index.d.ts",
      "default": "./dist/src/optimization/single-objective/optimizers/lbfgs-b/index.js"
    },
    "./src/stats": {
      "types": "./dist/src/stats/index.d.ts",
      "default": "./dist/src/stats/index.js"
    },
    "./src/time-series/feature-extraction": {
      "types": "./dist/src/time-series/feature-extraction/index.d.ts",
      "default": "./dist/src/time-series/feature-extraction/index.js"
    },
    "./src/time-series": {
      "types": "./dist/src/time-series/index.d.ts",
      "default": "./dist/src/time-series/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
