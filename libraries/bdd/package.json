{
  "name": "@datagrok-libraries/bdd",
  "version": "0.1.0",
  "description": "Behavioral automation for Datagrok: Gherkin features bound to the u2 and platform vocabulary, compiled into Playwright specs that packages own",
  "type": "module",
  "bin": {
    "grok-bdd": "./bin/grok-bdd.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    },
    "./bindings/*": {
      "types": "./dist/bindings/*.d.ts",
      "default": "./dist/bindings/*.js"
    },
    "./playwright.config": "./dist/playwright.config.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "bindings",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compile": "tsx src/cli.ts compile",
    "check": "tsx src/cli.ts compile --check",
    "lint": "tsx src/cli.ts lint",
    "list-steps": "tsx src/cli.ts list-steps",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "tsx --test tests/nouns.test.ts tests/compile.test.ts tests/project.test.ts tests/init.test.ts",
    "testLib": "npm run build && node bin/grok-bdd.js run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "^18.0.1",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@datagrok-libraries/test": "^1.4.0",
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.4"
  }
}
