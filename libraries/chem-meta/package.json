{
  "name": "@datagrok-libraries/chem-meta",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "author": {
    "name": "Maria Dolotova",
    "email": "mdolotova@datagrok.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "friendlyName": "Datagrok chem-meta library",
  "version": "1.2.12",
  "description": "RDKit JS API, utils for molfiles parsing",
  "dependencies": {
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/wu": "catalog:"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
