{
  "name": "@datagrok-libraries/codegen-async-to-sync",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "version": "0.1.0",
  "description": "Async-to-sync TypeScript codegen via ts-morph AST transform",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "codegen-async-to-sync": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
