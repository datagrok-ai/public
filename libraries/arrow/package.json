{
  "name": "@datagrok-libraries/arrow",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "fullName": "Arrow",
  "version": "1.1.1",
  "author": {
    "name": "Pavlo Polovyi",
    "email": "ppolovyi@datagrok.ai"
  },
  "description": "DataFrame ↔ Arrow IPC conversion (extracted from @datagrok/arrow)",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "dependencies": {
    "apache-arrow": "^21.0.0",
    "datagrok-api": "workspace:^"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
