{
  "name": "@datagrok-libraries/webcomponents-vue",
  "version": "0.3.4",
  "author": {
    "name": "Andrey Sharapov",
    "email": "andrey.sharapov@softwarecountry.com"
  },
  "description": "Datagrok web components vue wrappers",
  "dependencies": {
    "@datagrok-libraries/dock-spawn-dg": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "@datagrok-libraries/webcomponents": "workspace:^",
    "@vueuse/core": "^13.3.0",
    "@vueuse/rxjs": "^13.3.0",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "rxjs": "catalog:",
    "uuid": "^11.0.5",
    "vue": "^3.4.38",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@types/wu": "catalog:"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git",
    "directory": "libraries/webcomponents-vue"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
