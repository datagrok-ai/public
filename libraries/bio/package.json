{
  "name": "@datagrok-libraries/bio",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "friendlyName": "Datagrok bio library",
  "version": "6.0.4",
  "description": "Bio utilities, types supporting Macromolecule, Molecule3D data",
  "dependencies": {
    "@datagrok-libraries/chem-meta": "workspace:^",
    "@datagrok-libraries/gridext": "workspace:^",
    "@datagrok-libraries/hwe": "^1.0.0",
    "@datagrok-libraries/ml": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "@deck.gl/core": "8.8.12",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "fastest-levenshtein": "^1.0.16",
    "js-base64": "^3.7.5",
    "lru-cache": "^10.4.3",
    "mjolnir.js": "^2.7.0",
    "rxjs": "catalog:",
    "uuid": "^11.1.1",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/signals": "1.0.1",
    "@types/three": "^0.159.0",
    "@types/uuid": "^9.0.1",
    "@types/wu": "catalog:",
    "eslint-plugin-deprecation": "^3.0.0"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./src/consts": {
      "types": "./dist/src/consts/index.d.ts",
      "default": "./dist/src/consts/index.js"
    },
    "./src/molecule-3d": {
      "types": "./dist/src/molecule-3d/index.d.ts",
      "default": "./dist/src/molecule-3d/index.js"
    },
    "./src/pdb": {
      "types": "./dist/src/pdb/index.d.ts",
      "default": "./dist/src/pdb/index.js"
    },
    "./src/trees": {
      "types": "./dist/src/trees/index.d.ts",
      "default": "./dist/src/trees/index.js"
    },
    "./src/types": {
      "types": "./dist/src/types/index.d.ts",
      "default": "./dist/src/types/index.js"
    },
    "./src/utils/macromolecule": {
      "types": "./dist/src/utils/macromolecule/index.d.ts",
      "default": "./dist/src/utils/macromolecule/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
