{
  "name": "@datagrok-libraries/tutorials",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "author": {
    "name": "Dmytro Kovalyov",
    "email": "dkovalyov@datagrok.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "friendlyName": "Tutorials",
  "version": "1.7.8",
  "description": "Helpers for creating tutorials",
  "dependencies": {
    "@datagrok-libraries/compute-utils": "workspace:^",
    "@datagrok-libraries/utils": "workspace:^",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@types/wu": "catalog:",
    "dts-bundle-generator": "^7.0.0"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
