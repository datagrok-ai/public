{
  "name": "@datagrok-libraries/math",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "friendlyName": "Datagrok math library",
  "version": "1.2.7",
  "description": "Library for high performance computations",
  "dependencies": {
    "@webgpu/types": "^0.1.40",
    "cash-dom": "catalog:",
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "eslint-plugin-gpu-rules": "^1.0.0",
    "ml-levenberg-marquardt": "^4.1.3",
    "rxjs": "catalog:",
    "worker-loader": "^3.0.8",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/wu": "catalog:",
    "eslint-config-eslint": "^9.0.0"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./src/dbscan": {
      "types": "./dist/src/dbscan/index.d.ts",
      "default": "./dist/src/dbscan/index.js"
    },
    "./src/hierarchical-clustering": {
      "types": "./dist/src/hierarchical-clustering/index.d.ts",
      "default": "./dist/src/hierarchical-clustering/index.js"
    },
    "./src": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src/webGPU": {
      "types": "./dist/src/webGPU/index.d.ts",
      "default": "./dist/src/webGPU/index.js"
    },
    "./src/webGPU/multi-col-knn": {
      "types": "./dist/src/webGPU/multi-col-knn/index.d.ts",
      "default": "./dist/src/webGPU/multi-col-knn/index.js"
    },
    "./src/webGPU/umap": {
      "types": "./dist/src/webGPU/umap/index.d.ts",
      "default": "./dist/src/webGPU/umap/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
