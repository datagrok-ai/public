{
  "name": "@datagrok-libraries/gridext",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "fullName": "DG Grid Extensions",
  "version": "1.5.4",
  "author": {
    "name": "Dmytro Kovalyov",
    "email": "dkovalyov@datagrok.ai"
  },
  "description": "DG Grid Extensions",
  "dependencies": {
    "datagrok-api": "workspace:^",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "eslint-config-eslint": "^9.0.0"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
