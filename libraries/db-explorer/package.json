{
  "name": "@datagrok-libraries/db-explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrok-ai/public.git"
  },
  "author": {
    "name": "Davit Rizhinashvili",
    "email": "drizhinashvili@datagrok.ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "friendlyName": "Datagrok database explorer library",
  "version": "1.7.4",
  "description": "Library for exploring databases",
  "dependencies": {
    "datagrok-api": "workspace:^",
    "dayjs": "catalog:",
    "rxjs": "catalog:",
    "worker-loader": "^3.0.8",
    "wu": "catalog:"
  },
  "devDependencies": {
    "@types/wu": "catalog:",
    "eslint-config-eslint": "^9.0.0",
    "prettier-eslint": "16.3.0"
  },
  "scripts": {
    "build": "grok tsc -p tsconfig.json",
    "lint": "eslint --ext .ts,.tsx src"
  },
  "exports": {
    "./package.json": "./package.json",
    "./css/*": "./css/*",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
